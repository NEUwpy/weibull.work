{
  "title": "MDM梯度曲线不相交条件的数学分析",
  "parameters": {
    "beta": 2.0,
    "eta": 1000,
    "gamma": 1000,
    "n": 7,
    "offset": 0.2
  },
  "conditions": [
    {
      "section": "基本原理",
      "formula": "η_i = (t_i - γ) / [-ln(1-F(t_i))]^(1/β)",
      "sigma_function": "σ_η(γ) = std({η_i})",
      "gradient_function": "∇(γ) = dσ_η(γ)/dγ"
    },
    {
      "section": "梯度符号分析",
      "always_positive": "grad(gamma) > 0 -> sigma_eta单调递增 -> gamma=0",
      "always_negative": "grad(gamma) < 0 -> sigma_eta单调递减 -> gamma->t_min",
      "above_offset": "min(grad(gamma)) > 0.2",
      "below_offset": "max(grad(gamma)) < 0.2"
    },
    {
      "section": "理论推导",
      "key_observation": "小样本随机性导致 sigma_eta(gamma) 形态不确定",
      "small_sample_effect": "中位秩误差 -> eta_i 离散度非凸 -> sigma_eta 单调"
    },
    {
      "section": "数值分析",
      "parameters": "beta=2.0, eta=1000, gamma=1000",
      "sample_size": 7,
      "gamma_range": "[0, t_min*0.99]",
      "gradient_points": 60
    }
  ]
}