    "measured_repetitions": 5,
    "measurement_orders": [[32, 128, 512], [128, 512, 32], [512, 32, 128], [32, 512, 128], [128, 32, 512]],
    "batch_time_aggregate": "median",
    "concurrency_workers": 4,
    "concurrency_batch_size": 128,
    "concurrency_epochs": 1,
    "concurrency_repetitions": 3,
    "concurrency_warmup_tasks": 4,
    "effective_worker_aggregate": "max(1,q25)",
    "formal_max_epochs": 100,
    "unknown_training_size": 400000,
    "unknown_optimizer_batch_size": 128,
    "wall_time_limit_hours": 720,
    "runtime_headroom_factor": 2.0
