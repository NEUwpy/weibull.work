  <diagram id="statistical-inversion-route-v04" name="机制图 03｜统计关系反演路线">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1100" grid="1" gridSize="10" math="1" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="机制图 03｜统计关系反演路线" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#263238;strokeWidth=0;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="24" width="1720" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="核心问题：样本统计特征与总体参数之间有什么理论关系？" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#63758A;strokeWidth=0;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry as="geometry" x="40" y="78" width="1720" height="32" />
        </mxCell>
        <mxCell id="legend" value="蓝灰：共同信息与主流程　珊瑚：本路线的决定性原则　绿色：参数输出　紫灰：实现、改进与边界" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#63758A;strokeWidth=0;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry as="geometry" x="40" y="112" width="1720" height="28" />
        </mxCell>
        <mxCell id="sample" value="&lt;b&gt;① 样本 D&lt;/b&gt;&lt;br&gt;排序寿命样本&lt;br&gt;完整样本或指定观测条件" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#63758A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="info" value="&lt;b&gt;② 信息利用&lt;/b&gt;&lt;br&gt;样本矩、PWM／L矩、分位数、次序统计量、枢轴量、位置—尺度不变统计量及其期望／协方差。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#63758A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="475" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="principle" value="&lt;b&gt;③ 参数确定原则&lt;/b&gt;&lt;br&gt;建立理论等式、匹配关系或枢轴反演关系，再求解三个参数；条件线性估计通过协方差选择权重。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="910" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;④ 三参数估计&lt;/b&gt;&lt;br&gt;β̂、η̂、γ̂&lt;br&gt;以及方程残差、矩差、枢轴区间或条件方差" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#EEF8F2;strokeColor=#548A74;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1345" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="flow-1" value="" parent="1" edge="1" source="sample" target="info" style="html=1;strokeColor=#263238;strokeWidth=2.4;endArrow=block;endFill=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" value="" parent="1" edge="1" source="info" target="principle" style="html=1;strokeColor=#263238;strokeWidth=2.4;endArrow=block;endFill=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" value="" parent="1" edge="1" source="principle" target="output" style="html=1;strokeColor=#263238;strokeWidth=2.4;endArrow=block;endFill=1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branches-panel" value="&lt;b&gt;主要构造与方法分支&lt;/b&gt;" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#63758A;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;">
          <mxGeometry as="geometry" x="40" y="385" width="1665" height="300" />
        </mxCell>
        <mxCell id="branch-0" value="&lt;b&gt;MM／Weibull moments&lt;/b&gt;&lt;br&gt;用样本矩或Weibull矩显式恢复参数；近奇异的矩差会放大波动。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="445" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-0" value="" parent="1" edge="1" source="principle" target="branch-0" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-1" value="&lt;b&gt;PWM／L矩／TL矩&lt;/b&gt;&lt;br&gt;改变统计量权重或端部使用方式，保留矩关系反演的主线。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="615" y="445" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-1" value="" parent="1" edge="1" source="principle" target="branch-1" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-2" value="&lt;b&gt;分位数／次序统计量&lt;/b&gt;&lt;br&gt;用理论分位数、次序统计量分布或枢轴关系确定位置和其他参数。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1160" y="445" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-2" value="" parent="1" edge="1" source="principle" target="branch-2" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-3" value="&lt;b&gt;不变统计量 LSPF／LPF&lt;/b&gt;&lt;br&gt;先消除位置或尺度的一部分影响，再用统计量似然或恢复方程估计。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="550" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-3" value="" parent="1" edge="1" source="principle" target="branch-3" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-4" value="&lt;b&gt;条件线性最小方差&lt;/b&gt;&lt;br&gt;在给定参数或估计条件下，用期望与协方差选线性组合权重；性质不能无条件外推。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="615" y="550" width="500" height="82" />
        </mxCell>
