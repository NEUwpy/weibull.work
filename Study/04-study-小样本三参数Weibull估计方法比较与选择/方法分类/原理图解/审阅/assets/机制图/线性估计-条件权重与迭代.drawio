        <mxCell id="separate" value="位置MVLUE与MVLE-H估计对象不同；共享“线性最小方差”依据，不把它们缩成同一个公式或一条未经核实的继承链。" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#263238;strokeWidth=1.6;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=23;fontColor=#263238;fontStyle=0;spacing=0;">
