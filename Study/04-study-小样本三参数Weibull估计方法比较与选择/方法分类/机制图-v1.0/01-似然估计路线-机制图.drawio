        <mxCell id="wmle-equations" value="WMLE：权重进入形状／位置方程&lt;br&gt;S(r)=Σᵢ yᵢʳ，H(r)=Σᵢ yᵢʳ ln yᵢ&lt;br&gt;J₂/β + 平均ln y − H(β)/S(β) = 0&lt;br&gt;平均(1/y) · S(β)/S(β−1) = J₃&lt;br&gt;η^β = S(β)/(nJ₁)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="635" y="1290" width="510" height="255" as="geometry" />
        </mxCell>
        <mxCell id="weights" value="J₁、J₂由 n 确定；J₃依赖 n 与 β&lt;br&gt;联立更新 β、γ，再恢复 η" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="642" y="1550" width="495" height="82" as="geometry" />
