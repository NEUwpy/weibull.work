          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmle-interval" value="CMLE：将最小值密度贡献改为区间概率&lt;br&gt;fθ(x₍₁₎)  →  Fθ(x₍₁₎+h)−Fθ(x₍₁₎)&lt;br&gt;其余观测仍贡献各自的密度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#B07530;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1235" y="1290" width="495" height="165" as="geometry" />
        </mxCell>
        <mxCell id="cmle-target" value="ℓCMLE = ln[Fθ(x₍₁₎+h)−Fθ(x₍₁₎)]&lt;br&gt;+ Σᵢ₌₂ⁿ ln fθ(x₍ᵢ₎)&lt;br&gt;区间宽度 h 参与边界处理" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#B07530;fillColor=#FFF3E2;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
