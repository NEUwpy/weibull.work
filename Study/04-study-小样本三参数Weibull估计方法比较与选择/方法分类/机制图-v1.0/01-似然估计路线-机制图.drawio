        <mxCell id="cw-replacement" value="Cohen–Whitten：保留 Uβ=0、Uη=0&lt;br&gt;把 Uγ=0 换成另一统计关系&lt;br&gt;例：MMLE-II 使用最小值期望" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="635" y="1690" width="510" height="118" as="geometry" />
        </mxCell>
        <mxCell id="cw-minimum-expectation" value="x₍₁₎ = γ + η n^(−1/β) Γ(1+1/β)&lt;br&gt;与保留的两条似然方程联立" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#EEF2FA;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
