  <diagram id="distribution-mechanism-detail" name="分布匹配：变换、残差、概率间距与尺度一致性">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1900" background="#ffffff">
      <root>
        <mxCell id="0" />
