        <mxCell id="white-fit" value="uᵢ = a + bzᵢ + eᵢ&lt;br&gt;min Σ[uᵢ−a−bzᵢ]²&lt;br&gt;&lt;br&gt;β̂ = 1/b&lt;br&gt;η̂ = exp(a)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
