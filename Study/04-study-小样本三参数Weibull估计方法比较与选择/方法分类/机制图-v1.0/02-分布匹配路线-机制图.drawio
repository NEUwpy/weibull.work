        <mxCell id="subtitle" value="形状 β · 尺度 η · 位置 γ；排序寿命 x₍₁₎＜…＜x₍ₙ₎，候选位置 γ＜x₍₁₎" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
