        <mxCell id="cdf" value="F(x;θ) = 1 − exp{−[(x−γ)/η]ᵝ}" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="70" y="162" width="690" height="65" as="geometry" />
        </mxCell>
        <mxCell id="coordinates" value="pᵢ → qᵢ = −ln(1−pᵢ) → zᵢ = ln qᵢ&lt;br&gt;x₍ᵢ₎ → uᵢ(γ) = ln(x₍ᵢ₎−γ)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="795" y="160" width="1110" height="85" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="概率图关系：zᵢ ≈ βuᵢ(γ) − β lnη　　⇄　　逐点反推尺度：ηᵢ = (x₍ᵢ₎−γ) / qᵢ^(1/β)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
