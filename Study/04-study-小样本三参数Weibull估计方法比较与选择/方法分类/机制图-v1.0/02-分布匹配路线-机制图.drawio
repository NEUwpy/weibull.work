        </mxCell>
        <mxCell id="mps-equations" value="Fᵢ=F(x₍ᵢ₎;θ)，F₀=0，Fₙ₊₁=1&lt;br&gt;Dᵢ=Fᵢ−Fᵢ₋₁，θ̂=arg max Σᵢ lnDᵢ&lt;br&gt;候选 θ 改变每个概率区间的长度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
