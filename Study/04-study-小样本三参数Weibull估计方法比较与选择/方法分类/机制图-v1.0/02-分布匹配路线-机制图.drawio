          <mxGeometry x="765" y="1180" width="1190" height="630" as="geometry" />
        </mxCell>
        <mxCell id="mdm-title" value="C　MDM：每个点都能反推 η，让这些尺度尽量一致" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="785" y="1195" width="1145" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mdm-input" value="pᵢ=(i−0.3)/(n+0.4)；ηᵢ(β,γ)=(x₍ᵢ₎−γ)/[−ln(1−pᵢ)]^(1/β)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="790" y="1258" width="1130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mdm-conditional-title" value="① 固定 γ，只沿 β 压缩尺度离散" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="785" y="1330" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mdm-conditional" value="sη = std(η₁,…,ηₙ)&lt;br&gt;β*(γ)=arg minβ sη(β,γ)&lt;br&gt;当前求解域 β∈[0.1,15]&lt;br&gt;s*(γ)=sη[β*(γ),γ]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
