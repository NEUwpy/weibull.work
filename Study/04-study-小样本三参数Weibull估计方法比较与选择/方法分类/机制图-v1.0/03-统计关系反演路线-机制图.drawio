        <mxCell id="mvlue-title" value="D　条件位置 MVLUE：已知 β、η 时，把无偏位置估计按协方差组合" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="2110" width="1860" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-statistics" value="Tᵢ=X₍ᵢ₎−ηEβ(Y₍ᵢ₎)，E(Tᵢ)=γ&lt;br&gt;尤其 T₁=X₍₁₎−ηΓ(1+1/β)n^(−1/β)&lt;br&gt;取 S=Cov(T)，在 1ᵀc=1 下最小化 cᵀSc" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="2180" width="1030" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-weights" value="c = S⁻¹1 / (1ᵀS⁻¹1)&lt;br&gt;γ̂ = ΣcᵢTᵢ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1200" y="2185" width="680" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-plugin" value="与二参数估计组合时：临时 β̃、η̃ → 代入 Tᵢ 与 S 的理论系数 → 更新 γ → 平移样本并重估 β、η。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
