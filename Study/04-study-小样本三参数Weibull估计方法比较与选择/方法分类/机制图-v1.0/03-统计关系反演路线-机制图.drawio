<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="statistics-mechanism-detail" name="统计关系反演：提取统计量、消元与参数恢复">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="2500" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="统计关系反演：先提取可计算的量，再由理论关系拆开三个参数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="25" width="1920" height="55" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="模型依赖：X = γ + ηY，Y 的分布只由 β 决定。差值消去 γ，标准化比值进一步消去 η。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="88" width="1910" height="55" as="geometry" />
        </mxCell>
        <mxCell id="moment-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="175" width="1910" height="470" as="geometry" />
        </mxCell>
        <mxCell id="moment-title" value="A　常规矩法原型：偏度只留形状，再由方差、均值恢复尺度和位置" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="190" width="1870" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sample-moments" value="从样本提取&lt;br&gt;x̄ = mean(xᵢ)&lt;br&gt;m₂ = mean[(xᵢ−x̄)²]&lt;br&gt;m₃ = mean[(xᵢ−x̄)³]&lt;br&gt;样本偏度 g₁=m₃/m₂^(3/2)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="285" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="shape-equation" value="总体关系消去 γ、η&lt;br&gt;Gₖ(β)=Γ(1+k/β)&lt;br&gt;A₂=G₂−G₁²&lt;br&gt;A₃=G₃−3G₁G₂+2G₁³&lt;br&gt;解 g₁=A₃/A₂^(3/2) 得 β̂" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="620" y="285" width="640" height="220" as="geometry" />
        </mxCell>
        <mxCell id="moment-recover" value="参数恢复&lt;br&gt;η̂ = √[m₂/A₂(β̂)]&lt;br&gt;γ̂ = x̄−η̂G₁(β̂)&lt;br&gt;&lt;br&gt;先 β，再 η，再 γ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1340" y="285" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sample-to-equation" value="" edge="1" parent="1" source="sample-moments" target="shape-equation" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shape-to-recover" value="" edge="1" parent="1" source="shape-equation" target="moment-recover" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moment-explanation" value="中心化去掉位置；三阶中心矩与方差的 3/2 次方相除，尺度 η³ 抵消；最后用未标准化的量恢复 η、γ。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="552" width="1830" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cran-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="685" width="935" height="650" as="geometry" />
        </mxCell>
        <mxCell id="cran-title" value="B1　Cran：把幂矩改成生存曲线的积分" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="700" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cran-theory" value="非负位置 γ≥0 时&lt;br&gt;μ̄ₖ=∫₀∞[1−F(x)]ᵏdx&lt;br&gt;　 = γ+ηΓ(1+1/β)k^(−1/β)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="770" width="870" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cran-sample" value="样本阶梯积分（x₍₀₎=0）&lt;br&gt;m̄ₖ=Σᵣ₌₀ⁿ⁻¹(1−r/n)ᵏ[x₍ᵣ₊₁₎−x₍ᵣ₎]&lt;br&gt;提取 k=1、2、4；m̄₁=x̄" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="925" width="870" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cran-differences" value="d₁₂=m̄₁−m̄₂，d₂₄=m̄₂−m̄₄&lt;br&gt;总体 d₁₂/d₂₄=2^(1/β)&lt;br&gt;差值消 γ，再作比值消 η" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="1080" width="835" height="112" as="geometry" />
        </mxCell>
        <mxCell id="cran-recover" value="β̂ = ln2 / ln(d₁₂/d₂₄)&lt;br&gt;γ̂ = (m̄₁m̄₄−m̄₂²)/(m̄₁+m̄₄−2m̄₂)&lt;br&gt;η̂ = (m̄₁−γ̂)/Γ(1+1/β̂)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="1210" width="875" height="105" as="geometry" />
        </mxCell>
        <mxCell id="l-moments-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="1020" y="685" width="935" height="650" as="geometry" />
        </mxCell>
        <mxCell id="lm-title" value="B2　PWM → L矩 → TL矩：改造样本权重" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1040" y="700" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pwm" value="PWM：bᵣ=E[X F(X)ʳ]&lt;br&gt;b̂ᵣ=(1/n)Σᵢ[C(i−1,r)/C(n−1,r)]x₍ᵢ₎&lt;br&gt;秩权重将样本排序信息压缩成若干个量&lt;br&gt;μ̄ₖ=k E{X[1−F(X)]ᵏ⁻¹}：与 Cran 有泛函联系" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="770" width="880" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lm-conversion" value="L矩由同组 PWM 线性转换&lt;br&gt;λ₁=b₀&lt;br&gt;λ₂=2b₁−b₀&lt;br&gt;λ₃=6b₂−6b₁+b₀" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1055" y="915" width="850" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lm-recover" value="λ₁=γ+ηa₁(β)，λᵣ=ηaᵣ(β)（r≥2）&lt;br&gt;λ₃/λ₂ 定 β → λ₂ 定 η → λ₁ 定 γ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="1100" width="880" height="85" as="geometry" />
        </mxCell>
        <mxCell id="tl-moments" value="TL矩：改用概念样本内部次序量&lt;br&gt;例如 λ₁⁽¹,¹⁾=E[X₍₂:₃₎]&lt;br&gt;λ₂⁽¹,¹⁾=½E[X₍₃:₄₎−X₍₂:₄₎]&lt;br&gt;端部处理改变权重与理论关系，再作样本—总体匹配。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="1190" width="880" height="130" as="geometry" />
        </mxCell>
        <mxCell id="invariant-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="1375" width="1910" height="680" as="geometry" />
        </mxCell>
        <mxCell id="invariant-title" value="C　W 与 V：先消去哪些未知量，再对保留下来的信息建立联合密度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="1390" width="1870" height="55" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider-a" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=none;fillColor=none;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=1;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="anchor">
          <mxGeometry x="1000" y="1465" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider-b" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=none;fillColor=none;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=1;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="anchor">
          <mxGeometry x="1000" y="2010" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider" value="" edge="1" parent="1" source="invariant-divider-a" target="invariant-divider-b" style="html=1;rounded=0;strokeWidth=2;strokeColor=#D5E4DB;fontColor=#D5E4DB;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-title" value="LSPF：W 同时消去位置与尺度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="75" y="1465" width="885" height="55" as="geometry" />
        </mxCell>
        <mxCell id="w-cancel" value="Wᵢ=(X₍ᵢ₎−X₍₁₎)/(X₍ₙ₎−X₍₁₎)&lt;br&gt;　 =(Y₍ᵢ₎−Y₍₁₎)/(Y₍ₙ₎−Y₍₁₎)&lt;br&gt;W₁=0、Wₙ=1；内部 n−2 个量只依赖 β" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="1530" width="880" height="125" as="geometry" />
        </mxCell>
        <mxCell id="w-density" value="β̂W = arg maxβ fW(w₂,…,wₙ₋₁;β)&lt;br&gt;这里使用统计量联合密度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="1678" width="850" height="85" as="geometry" />
        </mxCell>
        <mxCell id="w-recover" value="代入 β̂W，记 b=β̂W&lt;br&gt;ηinit={mean[(xᵢ−x₍₁₎)ᵇ]}^(1/b)&lt;br&gt;γ̂W=x₍₁₎−ηinitΓ(1+1/b)n^(−1/b)&lt;br&gt;η̂W={mean[(xᵢ−γ̂W)ᵇ]}^(1/b)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="1800" width="880" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w-statistic-density" value="" edge="1" parent="1" source="w-cancel" target="w-density" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-density-recovery" value="" edge="1" parent="1" source="w-density" target="w-recover" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-mean" value="同一 W 也可匹配 Eβ(W 的均值) 来估 β；&lt;br&gt;换成联合密度，改变的是确定参数的原则。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="1975" width="880" height="65" as="geometry" />
        </mxCell>
        <mxCell id="v-title" value="LPF：V 只消去位置，尺度仍在" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1020" y="1465" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v-cancel" value="Vᵢ=X₍ᵢ₎−X₍₁₎=η(Y₍ᵢ₎−Y₍₁₎)&lt;br&gt;V₁=0；其余 n−1 个量仍依赖 η、β&lt;br&gt;少一个恒定分量，并保留绝对间距大小" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1025" y="1530" width="880" height="125" as="geometry" />
        </mxCell>
        <mxCell id="v-density" value="(η̂V0,β̂V)=arg maxη,β fV(v₂,…,vₙ;η,β)&lt;br&gt;下一阶段保留 β̂V，重新恢复 η、γ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1025" y="1678" width="870" height="85" as="geometry" />
        </mxCell>
        <mxCell id="v-recover" value="固定 b=β̂V，令 yᵢ=xᵢ−γ；解原文恢复方程&lt;br&gt;Σyᵢᵇ ln yᵢ / Σyᵢᵇ − mean(ln yᵢ)=1/b&lt;br&gt;得到 γ̂V 后：η̂V={mean[(xᵢ−γ̂V)ᵇ]}^(1/b)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1025" y="1795" width="880" height="145" as="geometry" />
        </mxCell>
        <mxCell id="v-statistic-density" value="" edge="1" parent="1" source="v-cancel" target="v-density" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-density-recovery" value="" edge="1" parent="1" source="v-density" target="v-recover" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-meaning" value="数据间距的联合密度保留相关结构；&lt;br&gt;图中的消元与恢复，是两次有不同对象的估计。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
