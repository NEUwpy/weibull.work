        <mxCell id="probability-plot-2" value="D2 线性关系拟合&lt;br&gt;\(z_i\approx\beta u_i-\beta\ln\eta\)&lt;br&gt;Soman回归\(u\)对\(z\)并作位置评分；&lt;br&gt;Park先最大化相关性定位。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1180" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="probability-plot-3" value="D3 按具体分支恢复&lt;br&gt;\(u=a+bz\)：\(\widehat\beta=1/b,\ \widehat\eta=e^a\)&lt;br&gt;\(z=a+bu\)：\(\widehat\beta=b,\ \widehat\eta=e^{-a/b}\)&lt;br&gt;Park也可转接二参数似然（路线一）。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1180" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="probability-plot-flow-1" value="" edge="1" parent="1" source="probability-plot-1" target="probability-plot-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="probability-plot-flow-2" value="" edge="1" parent="1" source="probability-plot-2" target="probability-plot-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-title" value="MPS：D1保留相邻CDF概率间距，D2对整组间距构造目标" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1410" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-1" value="D1 概率间距&lt;br&gt;\(F_i=F_\theta(x_{(i)}),\ F_0=0,\ F_{n+1}=1\)&lt;br&gt;\(\Delta_i(\theta)=F_i-F_{i-1}\)&lt;br&gt;样本位置固定，参数改变每段概率长度。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-2" value="D2 间距乘积准则&lt;br&gt;\(Q(\theta)=\sum_{i=1}^{n+1}\ln\Delta_i(\theta)\)&lt;br&gt;全部相邻区间共同进入目标；&lt;br&gt;不是原观测密度的乘积。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-3" value="D3 在支持域内求最大值&lt;br&gt;\(\widehat\theta=\operatorname*{arg\,max}_\theta Q(\theta)\)&lt;br&gt;候选参数通过同一CDF改变所有间距，&lt;br&gt;再按整组间距目标进行选择。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-flow-1" value="" edge="1" parent="1" source="probability-spacing-1" target="probability-spacing-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="probability-spacing-flow-2" value="" edge="1" parent="1" source="probability-spacing-2" target="probability-spacing-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-title" value="MDM：D1反推尺度，D2条件压缩尺度离散，D3再按梯度规则定位" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1700" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-1" value="D1 每个概率点反推尺度&lt;br&gt;\(q_i=-\ln(1-p_i)\)&lt;br&gt;\(\eta_i(\beta,\gamma)=\frac{x_{(i)}-\gamma}{q_i^{1/\beta}}\)&lt;br&gt;参数应使各点反推出的尺度尽量一致。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-2" value="D2 条件最小离散&lt;br&gt;\(s_\eta=\operatorname{std}(\eta_1,\ldots,\eta_n)\)&lt;br&gt;\(\beta^*(\gamma)=\operatorname*{arg\,min}_\beta s_\eta\)&lt;br&gt;\(s^*(\gamma)=s_\eta[\beta^*(\gamma),\gamma]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-3" value="D3 梯度定位，再恢复&lt;br&gt;\(\frac{ds^*}{d\gamma}(\widehat\gamma)=\delta\)&lt;br&gt;\(\widehat\beta=\beta^*(\widehat\gamma),\quad\widehat\eta=\frac1n\sum_i\eta_i\)&lt;br&gt;MDM-0.1取\(\delta=0.1\)，保留非负位置边界规则。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-flow-1" value="" edge="1" parent="1" source="pseudo-scale-1" target="pseudo-scale-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pseudo-scale-flow-2" value="" edge="1" parent="1" source="pseudo-scale-2" target="pseudo-scale-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="route-scope" value="以上按所用表示与准则接入同一路线；具体方法可另接其他机制，完整构造、边界与方法关系见细图及总图。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1980" width="2290" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
