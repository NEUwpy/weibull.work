        <mxCell id="cran-title" value="Cran：把S1改为生存曲线积分，借S2中的幂关系直接反演" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1120" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cran-1" value="S1 生存积分矩&lt;br&gt;\(\bar m_k=\int_0^\infty[1-\widehat F(x)]^k\,dx\)&lt;br&gt;提取\(k=1,2,4\)的阶梯积分；&lt;br&gt;\(\bar m_1=\bar x\)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1180" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cran-2" value="S2 非负位置时的总体关系&lt;br&gt;\(\bar\mu_k=\gamma+\eta\Gamma(1+1/\beta)k^{-1/\beta}\)&lt;br&gt;\(d_{12}=\bar m_1-\bar m_2,\ d_{24}=\bar m_2-\bar m_4\)&lt;br&gt;总体差比为\(2^{1/\beta}\)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1180" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cran-3" value="S3 差值与比值消元&lt;br&gt;\(\widehat\beta=\frac{\ln2}{\ln d_{12}-\ln d_{24}}\)&lt;br&gt;再代回同组关系恢复\(\eta,\gamma\)。&lt;br&gt;此构造保留\(\gamma\geq0\)及有效矩差条件。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1180" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cran-flow-1" value="" edge="1" parent="1" source="cran-1" target="cran-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cran-flow-2" value="" edge="1" parent="1" source="cran-2" target="cran-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-title" value="PWM／L矩／TL矩：S1改变秩权重，S2随之使用相应总体关系" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1410" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-1" value="S1 排序样本的加权特征&lt;br&gt;\(\widehat b_r=\frac1n\sum_i\frac{\binom{i-1}{r}}{\binom{n-1}{r}}x_{(i)}\)&lt;br&gt;\(\widehat\lambda_1=\widehat b_0,\ \widehat\lambda_2=2\widehat b_1-\widehat b_0\)&lt;br&gt;\(\widehat\lambda_3=6\widehat b_2-6\widehat b_1+\widehat b_0\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-2" value="S2 L矩的参数关系&lt;br&gt;\(\lambda_1=\gamma+\eta a_1(\beta)\)&lt;br&gt;\(\lambda_r=\eta a_r(\beta),\ r\geq2\)&lt;br&gt;TL矩修整端部次序量，权重和理论关系一起改变。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-3" value="S3 由L矩比及尺度关系反演&lt;br&gt;\(\frac{\widehat\lambda_3}{\widehat\lambda_2}=\frac{a_3(\widehat\beta)}{a_2(\widehat\beta)}\)&lt;br&gt;\(\widehat\eta=\widehat\lambda_2/a_2(\widehat\beta)\)&lt;br&gt;\(\widehat\gamma=\widehat\lambda_1-\widehat\eta a_1(\widehat\beta)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1470" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-flow-1" value="" edge="1" parent="1" source="rank-moments-1" target="rank-moments-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rank-moments-flow-2" value="" edge="1" parent="1" source="rank-moments-2" target="rank-moments-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-title" value="条件位置MVLUE：S3是已知形状、尺度下的选权，不是先反解形状" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1700" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-1" value="S1 次序量构造位置估计&lt;br&gt;给定\(\beta,\eta\)，\(X=\gamma+\eta Y\)&lt;br&gt;\(T_i=X_{(i)}-\eta\mathbb E_\beta[Y_{(i)}]\)&lt;br&gt;每个\(T_i\)都是位置的条件无偏估计。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-2" value="S2 期望与协方差关系&lt;br&gt;\(\mathbb E[T_i]=\gamma,\quad S=\operatorname{Cov}(T)\)&lt;br&gt;在\(\mathbf1^{\mathsf T}c=1\)下，&lt;br&gt;使组合方差\(c^{\mathsf T}Sc\)最小。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-3" value="S3 按协方差选权&lt;br&gt;\(c=\frac{S^{-1}\mathbf1}{\mathbf1^{\mathsf T}S^{-1}\mathbf1}\)&lt;br&gt;\(\widehat\gamma=c^{\mathsf T}T\)&lt;br&gt;未知\(\beta,\eta\)时须另接临时估计与更新。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="1760" width="700" height="205" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-flow-1" value="" edge="1" parent="1" source="conditional-weights-1" target="conditional-weights-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conditional-weights-flow-2" value="" edge="1" parent="1" source="conditional-weights-2" target="conditional-weights-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-title" value="W／V对照：消参构造不决定路线；各阶段依据实际估计准则接入机制" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="1990" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-1" value="构造W／V，保留不同参数信息&lt;br&gt;\(W_i=\frac{X_{(i)}-X_{(1)}}{X_{(n)}-X_{(1)}}\)：消\(\gamma,\eta\)&lt;br&gt;\(V_i=X_{(i)}-X_{(1)}\)：只消\(\gamma\)&lt;br&gt;选统计量本身尚未决定估计原则。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="2050" width="700" height="225" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-2" value="L1 似然构造 → L2 最大化&lt;br&gt;LSPF：\(\max_\beta f_W(w_2,\ldots,w_{n-1};\beta)\)&lt;br&gt;LPF：\(\max_{\eta,\beta}f_V(v_2,\ldots,v_n;\eta,\beta)\)&lt;br&gt;统计量联合密度不是MPS的概率间距。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="850" y="2050" width="700" height="225" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-3" value="分别看参数恢复的依据&lt;br&gt;LSPF用最小值期望修正位置（S2/S3），&lt;br&gt;再更新尺度；LPF保留形状，&lt;br&gt;解原文似然方程(9)(10)恢复位置、尺度，&lt;br&gt;该阶段仍体现L2。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1650" y="2050" width="700" height="225" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-flow-1" value="" edge="1" parent="1" source="invariant-cross-route-1" target="invariant-cross-route-2" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="invariant-cross-route-flow-2" value="" edge="1" parent="1" source="invariant-cross-route-2" target="invariant-cross-route-3" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#286D99;fontColor=#286D99;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notation" value="样例中\(Y\)为尺度1、位置0的Weibull变量。共同机制并不强制每个方法同一求解顺序，跨路线步骤在地图中继续连接。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="2310" width="2290" height="45" as="geometry" />
        </mxCell>
      </root>
