        </mxCell>
        <mxCell id="mps-equations" value="\(F_i=F(x_{(i)};\theta),\quad F_0=0,\quad F_{n+1}=1\)&lt;br&gt;\(D_i=F_i-F_{i-1}\)&lt;br&gt;\(\widehat{\theta}=\operatorname*{arg\,max}_{\theta}\sum_{i=1}^{n+1}\ln D_i\)&lt;br&gt;候选 \(\theta\) 改变每个概率区间的长度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="70" y="1620" width="620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="mdm-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="765" y="1180" width="1190" height="630" as="geometry" />
        </mxCell>
        <mxCell id="mdm-title" value="C　MDM：每个点都能反推 \(\eta\)，让这些尺度尽量一致" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="785" y="1195" width="1145" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mdm-input" value="\(p_i=\frac{i-0.3}{n+0.4},\qquad\eta_i(\beta,\gamma)=\frac{x_{(i)}-\gamma}{[-\ln(1-p_i)]^{\frac{1}{\beta}}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="790" y="1245" width="1130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mdm-conditional-title" value="① 固定 \(\gamma\)，只沿 \(\beta\) 压缩尺度离散" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="785" y="1330" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="mdm-conditional" value="\(s_\eta=\operatorname{std}(\eta_1,\ldots,\eta_n)\)&lt;br&gt;\(\beta^*(\gamma)=\operatorname*{arg\,min}_{\beta}\;s_\eta(\beta,\gamma)\)&lt;br&gt;当前求解域 \(\beta\in[0.1,15]\)&lt;br&gt;\(s^*(\gamma)=s_\eta[\beta^*(\gamma),\gamma]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
