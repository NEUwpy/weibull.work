        <mxCell id="park-gamma" value="Park 选位置：\(\widehat{\gamma}=\operatorname*{arg\,max}_{0\leq\gamma&lt;x_{(1)}}\;\operatorname{corr}[u(\gamma),z]\)&lt;br&gt;定位后可接上述回归，也可接平移样本的二参数 MLE" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
