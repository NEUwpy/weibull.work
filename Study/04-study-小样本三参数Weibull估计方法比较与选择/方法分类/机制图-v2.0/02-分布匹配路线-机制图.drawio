  <diagram id="distribution-mechanism-detail" name="分布匹配：变换、残差、概率间距与尺度一致性">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1900" background="#ffffff" math="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="分布匹配：同一条 Weibull 分布关系，怎样变成不同的估计依据？" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="25" width="1920" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="形状 \(\beta\) · 尺度 \(\eta\) · 位置 \(\gamma\)；排序寿命 \(x_{(1)}&lt;\cdots&lt;x_{(n)}\)，候选位置 \(\gamma&lt;x_{(1)}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
