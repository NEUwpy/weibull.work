        <mxCell id="park-fit" value="\(z_i=a+bu_i+e_i\)&lt;br&gt;\(\min_{a,b}\sum_{i=1}^n(z_i-a-bu_i)^2\)&lt;br&gt;&lt;br&gt;\(\widehat{\beta}=b\)&lt;br&gt;\(\widehat{\eta}=\exp\left(-\frac{a}{b}\right)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
