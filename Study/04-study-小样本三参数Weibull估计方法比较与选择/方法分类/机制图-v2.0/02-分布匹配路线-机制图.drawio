        <mxCell id="mps-equations" value="\(F_i=F(x_{(i)};\theta)\)&lt;br&gt;\(F_0=0,\quad F_{n+1}=1\)&lt;br&gt;\(D_i=F_i-F_{i-1}\)&lt;br&gt;\(\widehat\theta=\operatorname*{arg\,max}_{\theta}\sum_{i=1}^{n+1}\ln D_i\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
