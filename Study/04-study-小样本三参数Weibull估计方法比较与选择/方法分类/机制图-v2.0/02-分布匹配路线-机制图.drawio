        </mxCell>
        <mxCell id="coordinates" value="\(p_i\rightarrow q_i=-\ln(1-p_i)\rightarrow z_i=\ln q_i\)&lt;br&gt;\(x_{(i)}\rightarrow u_i(\gamma)=\ln(x_{(i)}-\gamma)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
