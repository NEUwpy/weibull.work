        </mxCell>
        <mxCell id="identity-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F1F7FB;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="145" width="1910" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cdf" value="\(F(x;\theta)=1-\exp\left[-\left(\frac{x-\gamma}{\eta}\right)^\beta\right]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="70" y="162" width="690" height="65" as="geometry" />
        </mxCell>
        <mxCell id="coordinates" value="\(p_i\longrightarrow q_i=-\ln(1-p_i)\longrightarrow z_i=\ln q_i\)&lt;br&gt;\(x_{(i)}\longrightarrow u_i(\gamma)=\ln(x_{(i)}-\gamma)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="795" y="160" width="1110" height="85" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="概率图关系：\(z_i\approx\beta u_i(\gamma)-\beta\ln\eta\)　　⇄　　逐点反推尺度：\(\eta_i=\frac{x_{(i)}-\gamma}{q_i^{\frac{1}{\beta}}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
