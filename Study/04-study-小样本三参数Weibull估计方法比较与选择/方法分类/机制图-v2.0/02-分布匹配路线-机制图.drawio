        <mxCell id="white-fit" value="\(u_i=a+bz_i+e_i\)&lt;br&gt;\(\min_{a,b}\sum_i(u_i-a-bz_i)^2\)&lt;br&gt;\(\widehat\beta=\frac{1}{b}\)&lt;br&gt;\(\widehat\eta=\exp(a)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="425" y="605" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="white-distance" value="水平残差 \(u_i-a-bz_i\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="65" y="900" width="720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="soman-gamma" value="Soman：选位置&lt;br&gt;\(\widehat\gamma=\operatorname*{arg\,max}_{\gamma&lt;x_{(1)}} F(\gamma)\)&lt;br&gt;\(F(\gamma)=\frac{(n-2)\mathrm{SST}_u}{(n-1)\mathrm{SSE}_u}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#286D99;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="75" y="990" width="700" height="190" as="geometry" />
