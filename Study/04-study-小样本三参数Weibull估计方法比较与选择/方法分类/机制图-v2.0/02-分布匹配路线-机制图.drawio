        <mxCell id="white-fit" value="\(u_i=a+bz_i+e_i\)&lt;br&gt;\(\min_{a,b}\sum_{i=1}^n(u_i-a-bz_i)^2\)&lt;br&gt;&lt;br&gt;\(\widehat{\beta}=\frac{1}{b}\)&lt;br&gt;\(\widehat{\eta}=\exp(a)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="455" y="622" width="470" height="235" as="geometry" />
        </mxCell>
        <mxCell id="white-distance" value="水平残差：在同一 \(z\) 上比较 \(u\)&lt;br&gt;示意点用于解释距离方向" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
