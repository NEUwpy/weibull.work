        </mxCell>
        <mxCell id="identity" value="\(z_i\approx\beta u_i-\beta\ln\eta\)&lt;br&gt;\(\eta_i=\frac{x_{(i)}-\gamma}{q_i^{1/\beta}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
