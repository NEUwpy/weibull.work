        <mxCell id="mdm-input" value="\(p_i=\frac{i-0.3}{n+0.4}\)&lt;br&gt;\(\eta_i(\beta,\gamma)=\frac{x_{(i)}-\gamma}{[-\ln(1-p_i)]^{1/\beta}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
