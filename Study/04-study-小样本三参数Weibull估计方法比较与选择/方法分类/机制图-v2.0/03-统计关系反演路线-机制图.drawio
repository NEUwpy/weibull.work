        <mxCell id="mvlue-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="2205" width="1910" height="340" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-title" value="D　条件位置 MVLUE：已知 \(\beta\)、\(\eta\) 时，把无偏位置估计按协方差组合" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="2220" width="1860" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-statistics" value="\(T_i=X_{(i)}-\eta\mathbb{E}_\beta[Y_{(i)}],\quad\mathbb{E}[T_i]=\gamma\)&lt;br&gt;尤其 \(T_1=X_{(1)}-\eta\Gamma(1+\frac{1}{\beta})n^{-\frac{1}{\beta}}\)&lt;br&gt;取 \(S=\operatorname{Cov}(T)\)，在 \(\mathbf{1}^{\mathsf{T}}c=1\) 下最小化 \(c^{\mathsf{T}}Sc\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="2290" width="1030" height="155" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-weights" value="\(c=\frac{S^{-1}\mathbf{1}}{\mathbf{1}^{\mathsf{T}}S^{-1}\mathbf{1}}\)&lt;br&gt;\(\widehat{\gamma}=\sum_{i=1}^n c_iT_i\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1200" y="2295" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-plugin" value="与二参数估计组合时：临时 \(\widetilde{\beta},\widetilde{\eta}\) → 代入 \(T_i\) 与 \(S\) 的理论系数 → 更新 \(\gamma\) → 平移样本并重估 \(\beta\)、\(\eta\)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="2470" width="1810" height="55" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="公式依据：Newby 矩构造；Cran（1988）；Hosking（1990）、Elamir–Seheult（2003）；LPF 原文 §2.1–2.2；位置 MVLUE 原文式(7)–(18)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
