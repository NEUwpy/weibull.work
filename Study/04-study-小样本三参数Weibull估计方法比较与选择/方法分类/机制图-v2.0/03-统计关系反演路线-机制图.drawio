        <mxCell id="identity" value="\(X=\gamma+\eta Y,\quad Y\sim\mathrm{Weibull}(\beta,1,0)\)；差值消 \(\gamma\)，标准化比值消 \(\eta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="50" y="88" width="3090" height="45" as="geometry" />
        </mxCell>
        <mxCell id="moment-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
