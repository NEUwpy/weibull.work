<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="statistics-mechanism-detail" name="统计关系反演：提取统计量、消元与参数恢复">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="2610" background="#ffffff" math="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="统计特征关系匹配与反演｜S1 特征 → S2 理论关系 → S3 识别参数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="25" width="1920" height="55" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="模型依赖：\(X=\gamma+\eta Y\)，\(Y\) 的分布只由 \(\beta\) 决定。差值消去 \(\gamma\)，标准化比值进一步消去 \(\eta\)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="88" width="1910" height="55" as="geometry" />
        </mxCell>
        <mxCell id="moment-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="175" width="1910" height="470" as="geometry" />
        </mxCell>
        <mxCell id="moment-title" value="A　常规矩示例：选偏度、方差与均值，匹配理论关系" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="190" width="1870" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sample-moments" value="从样本提取&lt;br&gt;\(\bar{x}=\frac{1}{n}\sum_{i=1}^n x_i\)&lt;br&gt;\(m_2=\frac{1}{n}\sum_{i=1}^n(x_i-\bar{x})^2\)&lt;br&gt;\(m_3=\frac{1}{n}\sum_{i=1}^n(x_i-\bar{x})^3\)&lt;br&gt;样本偏度 \(g_1=\frac{m_3}{m_2^{3/2}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="285" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="shape-equation" value="总体关系消去 \(\gamma\)、\(\eta\)&lt;br&gt;\(G_k(\beta)=\Gamma\left(1+\frac{k}{\beta}\right)\)&lt;br&gt;\(A_2=G_2-G_1^2\)&lt;br&gt;\(A_3=G_3-3G_1G_2+2G_1^3\)&lt;br&gt;解 \(g_1=\frac{A_3}{A_2^{3/2}}\) 得 \(\widehat{\beta}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="620" y="285" width="640" height="220" as="geometry" />
        </mxCell>
        <mxCell id="moment-recover" value="参数恢复&lt;br&gt;\(\widehat{\eta}=\sqrt{\frac{m_2}{A_2(\widehat{\beta})}}\)&lt;br&gt;\(\widehat{\gamma}=\bar{x}-\widehat{\eta}G_1(\widehat{\beta})\)&lt;br&gt;&lt;br&gt;先 \(\beta\)，再 \(\eta\)，再 \(\gamma\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1340" y="285" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sample-to-equation" value="" edge="1" parent="1" source="sample-moments" target="shape-equation" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shape-to-recover" value="" edge="1" parent="1" source="shape-equation" target="moment-recover" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moment-explanation" value="中心化去掉位置；三阶中心矩与方差的 \(\frac{3}{2}\) 次方相除，尺度 \(\eta^3\) 抵消；最后用未标准化的量恢复 \(\eta\)、\(\gamma\)。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="552" width="1830" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cran-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="685" width="935" height="700" as="geometry" />
        </mxCell>
        <mxCell id="cran-title" value="B1　Cran：把幂矩改成生存曲线的积分" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="700" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cran-theory" value="非负位置 \(\gamma\geq0\) 时&lt;br&gt;\(\bar{\mu}_k=\int_0^\infty[1-F(x)]^k\,dx\)&lt;br&gt;\(=\gamma+\eta\Gamma\left(1+\frac{1}{\beta}\right)k^{-\frac{1}{\beta}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="770" width="870" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cran-sample" value="样本阶梯积分（\(x_{(0)}=0\)）&lt;br&gt;\(\bar{m}_k=\sum_{r=0}^{n-1}\left(1-\frac{r}{n}\right)^k[x_{(r+1)}-x_{(r)}]\)&lt;br&gt;提取 \(k=1,2,4\)；\(\bar{m}_1=\bar{x}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="925" width="870" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cran-differences" value="\(d_{12}=\bar{m}_1-\bar{m}_2,\quad d_{24}=\bar{m}_2-\bar{m}_4\)&lt;br&gt;总体 \(\frac{d_{12}}{d_{24}}=2^{\frac{1}{\beta}}\)&lt;br&gt;差值消 \(\gamma\)，再作比值消 \(\eta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="1080" width="835" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cran-recover" value="\(\widehat{\beta}=\frac{\ln2}{\ln d_{12}-\ln d_{24}}\)&lt;br&gt;\(\widehat{\gamma}=\frac{\bar{m}_1\bar{m}_4-\bar{m}_2^2}{\bar{m}_1+\bar{m}_4-2\bar{m}_2}\)&lt;br&gt;\(\widehat{\eta}=\frac{\bar{m}_1-\widehat{\gamma}}{\Gamma(1+\frac{1}{\widehat{\beta}})}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="75" y="1220" width="875" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l-moments-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="1020" y="685" width="935" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lm-title" value="B2　PWM → L矩 → TL矩：改造样本权重" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1040" y="700" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pwm" value="PWM：\(b_r=\mathbb{E}[XF(X)^r]\)&lt;br&gt;\(\widehat{b}_r=\frac{1}{n}\sum_{i=1}^n\frac{\binom{i-1}{r}}{\binom{n-1}{r}}x_{(i)}\)&lt;br&gt;秩权重将样本排序信息压缩成若干个量&lt;br&gt;\(\bar{\mu}_k=k\mathbb{E}\{X[1-F(X)]^{k-1}\}\)：与 Cran 有泛函联系" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="770" width="880" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lm-conversion" value="L矩由同组 PWM 线性转换&lt;br&gt;\(\lambda_1=b_0\)&lt;br&gt;\(\lambda_2=2b_1-b_0\)&lt;br&gt;\(\lambda_3=6b_2-6b_1+b_0\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1055" y="965" width="850" height="145" as="geometry" />
        </mxCell>
        <mxCell id="lm-recover" value="\(\lambda_1=\gamma+\eta a_1(\beta),\quad\lambda_r=\eta a_r(\beta)\ (r\geq2)\)&lt;br&gt;\(\frac{\lambda_3}{\lambda_2}\) 定 \(\beta\) → \(\lambda_2\) 定 \(\eta\) → \(\lambda_1\) 定 \(\gamma\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="1120" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tl-moments" value="TL矩：改用概念样本内部次序量&lt;br&gt;例如 \(\lambda_1^{(1,1)}=\mathbb{E}[X_{(2:3)}]\)&lt;br&gt;\(\lambda_2^{(1,1)}=\frac{1}{2}\mathbb{E}[X_{(3:4)}-X_{(2:4)}]\)&lt;br&gt;端部处理改变权重与理论关系，再作样本—总体匹配。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1040" y="1225" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="invariant-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F5F7FA;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="45" y="1425" width="1910" height="755" as="geometry" />
        </mxCell>
        <mxCell id="invariant-title" value="C　不变统计量对照：构造、似然与后续参数恢复分别辨认" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="1440" width="1870" height="55" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider-a" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=none;fillColor=none;fontColor=#243449;fontFamily=Times New Roman;fontSize=1;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="anchor">
          <mxGeometry x="1000" y="1515" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider-b" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=none;fillColor=none;fontColor=#243449;fontFamily=Times New Roman;fontSize=1;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="anchor">
          <mxGeometry x="1000" y="2060" width="0" height="0" as="geometry" />
        </mxCell>
        <mxCell id="invariant-divider" value="" edge="1" parent="1" source="invariant-divider-a" target="invariant-divider-b" style="html=1;rounded=0;strokeWidth=2;strokeColor=#D5E4DB;fontColor=#D5E4DB;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=none;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-title" value="LSPF：\(W\) 同时消去位置与尺度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="75" y="1515" width="885" height="55" as="geometry" />
        </mxCell>
        <mxCell id="w-cancel" value="\(W_i=\frac{X_{(i)}-X_{(1)}}{X_{(n)}-X_{(1)}}=\frac{Y_{(i)}-Y_{(1)}}{Y_{(n)}-Y_{(1)}}\)&lt;br&gt;\(W_1=0,\quad W_n=1\)；内部 \(n-2\) 个量只依赖 \(\beta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="1580" width="880" height="135" as="geometry" />
        </mxCell>
        <mxCell id="w-density" value="\(\widehat{\beta}_W=\operatorname*{arg\,max}_{\beta}\;f_W(w_2,\ldots,w_{n-1};\beta)\)&lt;br&gt;这里使用统计量联合密度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AB4D3D;fillColor=#FFF7F3;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="80" y="1728" width="850" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w-recover" value="代入 \(\widehat{\beta}_W\)，记 \(b=\widehat{\beta}_W\)&lt;br&gt;\(\eta_{\mathrm{init}}=\left[\frac{1}{n}\sum_{i=1}^n(x_i-x_{(1)})^b\right]^{\frac{1}{b}}\)&lt;br&gt;\(\widehat{\gamma}_W=x_{(1)}-\eta_{\mathrm{init}}\Gamma(1+\frac{1}{b})n^{-\frac{1}{b}}\)&lt;br&gt;\(\widehat{\eta}_W=\left[\frac{1}{n}\sum_{i=1}^n(x_i-\widehat{\gamma}_W)^b\right]^{\frac{1}{b}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="1840" width="880" height="215" as="geometry" />
        </mxCell>
        <mxCell id="w-statistic-density" value="" edge="1" parent="1" source="w-cancel" target="w-density" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-density-recovery" value="" edge="1" parent="1" source="w-density" target="w-recover" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-mean" value="同一 \(W\) 也可匹配 \(\mathbb{E}_\beta[\bar{W}]\) 来估 \(\beta\)；&lt;br&gt;换成联合密度，改变的是确定参数的原则。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="80" y="2070" width="880" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v-title" value="LPF：\(V\) 只消去位置，尺度仍在" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1020" y="1515" width="895" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v-cancel" value="\(V_i=X_{(i)}-X_{(1)}=\eta(Y_{(i)}-Y_{(1)})\)&lt;br&gt;\(V_1=0\)；其余 \(n-1\) 个量仍依赖 \(\eta\)、\(\beta\)&lt;br&gt;少一个恒定分量，并保留绝对间距大小" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1025" y="1580" width="880" height="125" as="geometry" />
        </mxCell>
        <mxCell id="v-density" value="\((\widehat{\eta}_{V0},\widehat{\beta}_V)=\operatorname*{arg\,max}_{\eta,\beta}\;f_V(v_2,\ldots,v_n;\eta,\beta)\)&lt;br&gt;下一阶段保留 \(\widehat{\beta}_V\)，重新恢复 \(\eta\)、\(\gamma\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AB4D3D;fillColor=#FFF7F3;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1025" y="1728" width="870" height="140" as="geometry" />
        </mxCell>
        <mxCell id="v-recover" value="L2 代入形状估计，固定 \(b=\widehat{\beta}_V\)，令 \(y_i=x_i-\gamma\)；解原文似然方程&lt;br&gt;\(\frac{\sum_{i=1}^n y_i^b\ln y_i}{\sum_{i=1}^n y_i^b}-\frac{1}{n}\sum_{i=1}^n\ln y_i=\frac{1}{b}\)&lt;br&gt;得到 \(\widehat{\gamma}_V\) 后：\(\widehat{\eta}_V=\left[\frac{1}{n}\sum_{i=1}^n(x_i-\widehat{\gamma}_V)^b\right]^{\frac{1}{b}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1025" y="1880" width="880" height="210" as="geometry" />
        </mxCell>
        <mxCell id="v-statistic-density" value="" edge="1" parent="1" source="v-cancel" target="v-density" style="html=1;rounded=0;strokeWidth=2;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
