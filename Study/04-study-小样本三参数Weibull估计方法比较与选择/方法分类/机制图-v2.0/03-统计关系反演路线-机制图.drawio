        <mxCell id="w-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="1930" y="165" width="600" height="875" as="geometry" />
        </mxCell>
        <mxCell id="v-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F8FAFC;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="2560" y="165" width="600" height="875" as="geometry" />
        </mxCell>
        <mxCell id="moment-title" value="A  常规矩" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="60" y="180" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sample-moments" value="\(\bar{x}=\frac{1}{n}\sum_i x_i\)&lt;br&gt;\(m_2=\frac{1}{n}\sum_i(x_i-\bar{x})^2\)&lt;br&gt;\(m_3=\frac{1}{n}\sum_i(x_i-\bar{x})^3\)&lt;br&gt;\(g_1=\frac{m_3}{m_2^{3/2}}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="65" y="255" width="550" height="210" as="geometry" />
        </mxCell>
        <mxCell id="shape-equation" value="\(G_k(\beta)=\Gamma\!\left(1+\frac{k}{\beta}\right)\)&lt;br&gt;\(A_2=G_2-G_1^2\)&lt;br&gt;\(A_3=G_3-3G_1G_2+2G_1^3\)&lt;br&gt;\(g_1=\frac{A_3}{A_2^{3/2}}\ \Rightarrow\ \widehat\beta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="65" y="530" width="550" height="210" as="geometry" />
        </mxCell>
        <mxCell id="moment-recover" value="\(\widehat\eta=\sqrt{\frac{m_2}{A_2(\widehat\beta)}}\)&lt;br&gt;\(\widehat\gamma=\bar{x}-\widehat\eta G_1(\widehat\beta)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#EAF4ED;fontColor=#243449;fontFamily=Times New Roman;fontSize=28;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="65" y="815" width="550" height="145" as="geometry" />
        </mxCell>
        <mxCell id="sample-to-equation" value="" edge="1" parent="1" source="sample-moments" target="shape-equation" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shape-to-recover" value="" edge="1" parent="1" source="shape-equation" target="moment-recover" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cran-title" value="B  Cran：生存曲线积分" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="690" y="180" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cran-theory" value="\(\gamma\geq0\)&lt;br&gt;\(\bar\mu_k=\int_0^\infty[1-F(x)]^k\,dx\)&lt;br&gt;\(=\gamma+\eta\Gamma\!\left(1+\frac{1}{\beta}\right)k^{-1/\beta}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="695" y="255" width="550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cran-sample" value="\(x_{(0)}=0,\quad k=1,2,4\)&lt;br&gt;\(\bar m_k=\sum_{r=0}^{n-1}\left(1-\frac{r}{n}\right)^k[x_{(r+1)}-x_{(r)}]\)&lt;br&gt;\(\bar m_1=\bar x\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="695" y="440" width="550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cran-differences" value="\(d_{12}=\bar m_1-\bar m_2\)&lt;br&gt;\(d_{24}=\bar m_2-\bar m_4\)&lt;br&gt;\(\frac{d_{12}}{d_{24}}=2^{1/\beta}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="695" y="625" width="550" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cran-recover" value="\(\widehat\beta=\frac{\ln2}{\ln d_{12}-\ln d_{24}}\)&lt;br&gt;\(\widehat\gamma=\frac{\bar m_1\bar m_4-\bar m_2^2}{\bar m_1+\bar m_4-2\bar m_2}\)&lt;br&gt;\(\widehat\eta=\frac{\bar m_1-\widehat\gamma}{\Gamma(1+1/\widehat\beta)}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="695" y="800" width="550" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lm-title" value="C  PWM → L矩 → TL矩" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1320" y="180" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pwm" value="\(b_r=\mathbb{E}[XF(X)^r]\)&lt;br&gt;\(\widehat b_r=\frac{1}{n}\sum_{i=1}^n\frac{\binom{i-1}{r}}{\binom{n-1}{r}}x_{(i)}\)&lt;br&gt;\(\bar\mu_k=k\mathbb{E}\{X[1-F(X)]^{k-1}\}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1325" y="255" width="550" height="165" as="geometry" />
        </mxCell>
        <mxCell id="lm-conversion" value="\(\lambda_1=b_0\)&lt;br&gt;\(\lambda_2=2b_1-b_0\)&lt;br&gt;\(\lambda_3=6b_2-6b_1+b_0\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1325" y="455" width="550" height="145" as="geometry" />
        </mxCell>
        <mxCell id="lm-recover" value="\(\lambda_1=\gamma+\eta a_1(\beta)\)&lt;br&gt;\(\lambda_r=\eta a_r(\beta),\quad r\geq2\)&lt;br&gt;\(\lambda_3/\lambda_2\rightarrow\beta\)&lt;br&gt;\(\lambda_2\rightarrow\eta,\quad\lambda_1\rightarrow\gamma\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1325" y="635" width="550" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tl-moments" value="TL矩&lt;br&gt;\(\lambda_1^{(1,1)}=\mathbb{E}[X_{(2:3)}]\)&lt;br&gt;\(\lambda_2^{(1,1)}=\frac12\mathbb{E}[X_{(3:4)}-X_{(2:4)}]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#EAF4ED;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1325" y="850" width="550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w-title" value="D  LSPF：消去位置与尺度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="1950" y="180" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="w-cancel" value="\(W_i=\frac{X_{(i)}-X_{(1)}}{X_{(n)}-X_{(1)}}\)&lt;br&gt;\(=\frac{Y_{(i)}-Y_{(1)}}{Y_{(n)}-Y_{(1)}}\)&lt;br&gt;\(W_1=0,\quad W_n=1\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1955" y="255" width="550" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w-density" value="\(\widehat\beta_W=\operatorname*{arg\,max}_{\beta}\)&lt;br&gt;\(f_W(w_2,\ldots,w_{n-1};\beta)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AB4D3D;fillColor=#FFF7F3;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1955" y="465" width="550" height="125" as="geometry" />
        </mxCell>
        <mxCell id="w-recover" value="\(b=\widehat\beta_W\)&lt;br&gt;\(\eta_{\mathrm{init}}=\left[\frac{1}{n}\sum_i(x_i-x_{(1)})^b\right]^{1/b}\)&lt;br&gt;\(\widehat\gamma_W=x_{(1)}-\eta_{\mathrm{init}}\Gamma(1+1/b)n^{-1/b}\)&lt;br&gt;\(\widehat\eta_W=\left[\frac{1}{n}\sum_i(x_i-\widehat\gamma_W)^b\right]^{1/b}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1955" y="655" width="550" height="245" as="geometry" />
        </mxCell>
        <mxCell id="w-mean" value="均值关系分支：\(\mathbb{E}_\beta[\bar W]\rightarrow\beta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="1955" y="955" width="550" height="50" as="geometry" />
        </mxCell>
        <mxCell id="w-statistic-density" value="" edge="1" parent="1" source="w-cancel" target="w-density" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="w-density-recovery" value="" edge="1" parent="1" source="w-density" target="w-recover" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-title" value="E  LPF：消去位置" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="2580" y="180" width="560" height="55" as="geometry" />
        </mxCell>
        <mxCell id="v-cancel" value="\(V_i=X_{(i)}-X_{(1)}\)&lt;br&gt;\(=\eta(Y_{(i)}-Y_{(1)})\)&lt;br&gt;\(V_1=0\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="2585" y="255" width="550" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v-density" value="\((\widehat\eta_{V0},\widehat\beta_V)=\operatorname*{arg\,max}_{\eta,\beta}\)&lt;br&gt;\(f_V(v_2,\ldots,v_n;\eta,\beta)\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AB4D3D;fillColor=#FFF7F3;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="2585" y="465" width="550" height="125" as="geometry" />
        </mxCell>
        <mxCell id="v-recover" value="固定 \(b=\widehat\beta_V,\quad y_i=x_i-\gamma\)&lt;br&gt;\(\frac{\sum_i y_i^b\ln y_i}{\sum_i y_i^b}-\frac{1}{n}\sum_i\ln y_i=\frac{1}{b}\)&lt;br&gt;\(\Downarrow\ \widehat\gamma_V\)&lt;br&gt;\(\widehat\eta_V=\left[\frac{1}{n}\sum_i(x_i-\widehat\gamma_V)^b\right]^{1/b}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="2585" y="655" width="550" height="245" as="geometry" />
        </mxCell>
        <mxCell id="v-statistic-density" value="" edge="1" parent="1" source="v-cancel" target="v-density" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v-density-recovery" value="" edge="1" parent="1" source="v-density" target="v-recover" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-bg" value="" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#DFE6EB;fillColor=#F2F8F4;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="background">
          <mxGeometry x="40" y="1080" width="3120" height="275" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-title" value="F  条件位置 MVLUE｜给定 \(\beta,\eta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="65" y="1095" width="1090" height="55" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-statistics" value="\(T_i=X_{(i)}-\eta\mathbb{E}_\beta[Y_{(i)}],\quad\mathbb{E}[T_i]=\gamma\)&lt;br&gt;\(T_1=X_{(1)}-\eta\Gamma(1+1/\beta)n^{-1/\beta}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="65" y="1170" width="1090" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-covariance" value="\(S=\operatorname{Cov}(T),\quad\mathbf1^{\mathsf T}c=1\)&lt;br&gt;\(\min_c c^{\mathsf T}Sc\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=28;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1240" y="1160" width="730" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-weights" value="\(c=\frac{S^{-1}\mathbf1}{\mathbf1^{\mathsf T}S^{-1}\mathbf1}\)&lt;br&gt;\(\widehat\gamma=\sum_i c_iT_i\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#26745A;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="2060" y="1160" width="690" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-minimize" value="" edge="1" parent="1" source="mvlue-covariance" target="mvlue-weights" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#26745A;fontColor=#26745A;fontFamily=Times New Roman;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mvlue-plugin" value="代入 \(\widetilde\beta,\widetilde\eta\)&lt;br&gt;↓ 更新 \(\gamma\)&lt;br&gt;↓ 平移后重估" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
