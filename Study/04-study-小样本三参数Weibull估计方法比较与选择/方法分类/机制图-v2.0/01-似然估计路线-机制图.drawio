        <mxCell id="wmle-equations" value="WMLE：\(S(r)=\sum_i y_i^r,\quad H(r)=\sum_i y_i^r\ln y_i\)&lt;br&gt;\(\frac{J_2}{\beta}+\overline{\ln y}-\frac{H(\beta)}{S(\beta)}=0\)&lt;br&gt;\(\overline{y^{-1}}\,\frac{S(\beta)}{S(\beta-1)}=J_3,\quad\eta^\beta=\frac{S(\beta)}{nJ_1}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
