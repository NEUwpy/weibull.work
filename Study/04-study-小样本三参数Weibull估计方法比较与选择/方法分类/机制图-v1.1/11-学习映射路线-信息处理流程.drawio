<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="learning-information-flow" name="学习映射｜把多组参数预测误差写成训练目标，再选择估计函数">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="学习映射｜把多组参数预测误差写成训练目标，再选择估计函数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=35;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="20" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="参数标签提供训练判据；要确定的是共享映射的权重φ，训练结束后再用于当前新样本。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="100" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="learn-heading" value="训练目标怎样由样本及其真值形成？" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="190" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="learn-0" value="把每组样本变成统一特征&lt;br&gt;tⱼ=T(Dⱼ)&lt;br&gt;如排序值、分位数或统计量&lt;br&gt;用当前映射预测θ̂ⱼ=hφ(tⱼ)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AE6C25;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="260" width="540" height="245" as="geometry" />
        </mxCell>
        <mxCell id="learn-1" value="逐组对照参数真值，形成损失&lt;br&gt;将θ̂ⱼ与对应标签θⱼ比较&lt;br&gt;ℒ(φ)=(1/m)Σⱼℓ(θ̂ⱼ,θⱼ)&lt;br&gt;例：ℓ=Σₖ(θ̂ⱼₖ−θⱼₖ)²&lt;br&gt;多组预测误差合成一个训练目标" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AE6C25;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="260" width="540" height="245" as="geometry" />
        </mxCell>
        <mxCell id="learn-edge-1" value="" edge="1" parent="1" source="learn-0" target="learn-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#AE6C25;fontColor=#AE6C25;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="learn-2" value="按预测误差选择映射权重&lt;br&gt;φ*=argminφ ℒ(φ)&lt;br&gt;按梯度等方法更新φ并重新预测&lt;br&gt;使训练样本上的规定损失更小" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AE6C25;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="260" width="540" height="245" as="geometry" />
        </mxCell>
        <mxCell id="learn-edge-2" value="" edge="1" parent="1" source="learn-1" target="learn-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#AE6C25;fontColor=#AE6C25;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="training-loop" value="更新φ→重算各组预测与损失→继续减小训练目标" edge="1" parent="1" source="learn-2" target="learn-0" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#AE6C25;fontColor=#AE6C25;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" relationKind="feedback" evidence="" labelX="1000" labelY="580">
          <mxGeometry relative="1" as="geometry" x="0.0">
            <Array as="points">
              <mxPoint x="1680" y="580" />
              <mxPoint x="320" y="580" />
            </Array>
            <mxPoint x="0.0" y="0.0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fixed" value="训练完成后固定φ*&lt;br&gt;新样本仍按同一T提取特征，再计算hφ*(T(D))&lt;br&gt;参数估计来自已经确定的映射" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F0F8F3;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;fontStyle=1;" renderRole="method">
          <mxGeometry x="390" y="715" width="1220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="freeze" value="" edge="1" parent="1" source="learn-2" target="fixed" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#AE6C25;fontColor=#AE6C25;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1970" y="382.5" />
              <mxPoint x="1970" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>