<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="distribution-information-flow" name="分布匹配｜先构造可比较的分布量，再建立评分并选择参数">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1370" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="分布匹配｜先构造可比较的分布量，再建立评分并选择参数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=35;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="20" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="各行展开一种实际构造：比较对象、评分的来源和参数判定原则连续相接。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="100" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="plot-heading" value="概率图：把Weibull分布关系变成直线" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="190" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="plot-0" value="构造变换后的坐标&lt;br&gt;uᵢ(γ)=ln(x₍ᵢ₎−γ)&lt;br&gt;Park：pᵢ→zᵢ=ln[−ln(1−pᵢ)]&lt;br&gt;White：取标准对数Weibull&lt;br&gt;次序统计量的期望" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="plot-1" value="由分布关系形成回归残差&lt;br&gt;z≈βu−β lnη&lt;br&gt;选u对z或z对u回归&lt;br&gt;Q=Σ(观测坐标−拟合坐标)²" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="plot-edge-1" value="" edge="1" parent="1" source="plot-0" target="plot-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="plot-2" value="依据拟合程度与位置评分确定&lt;br&gt;回归使Q最小&lt;br&gt;Soman按F评分、Park按相关性定γ&lt;br&gt;再由斜率和截距反解β、η" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="plot-edge-2" value="" edge="1" parent="1" source="plot-1" target="plot-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cdf-heading" value="CDF差异／MPS：把观测位置换成累积概率，再比较整组评分" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="560" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cdf-0" value="在候选θ下计算观测的CDF值&lt;br&gt;Fᵢ=Fθ(x₍ᵢ₎)&lt;br&gt;MPS另加F₀=0、Fₙ₊₁=1&lt;br&gt;候选θ改变各概率区间的长度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="630" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cdf-1" value="把概率偏离或间距合成目标&lt;br&gt;CDF差异：D(θ)=Σᵢwᵢ(Fᵢ−pᵢ)²&lt;br&gt;MPS间距：Dᵢ=Fᵢ−Fᵢ₋₁&lt;br&gt;间距评分：Q(θ)=Σᵢ₌₁ⁿ⁺¹ln Dᵢ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="630" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cdf-edge-1" value="" edge="1" parent="1" source="cdf-0" target="cdf-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cdf-2" value="按所选目标比较候选参数&lt;br&gt;差异准则：θ̂=argminθ D(θ)&lt;br&gt;间距准则：θ̂=argmaxθ Q(θ)&lt;br&gt;比较的是整组概率关系的总评分" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="630" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cdf-edge-2" value="" edge="1" parent="1" source="cdf-1" target="cdf-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdm-heading" value="MDM：同一分布模型应让各观测反推的尺度尽量一致" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="930" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mdm-0" value="每个观测反推一个尺度&lt;br&gt;qᵢ=−ln(1−pᵢ)&lt;br&gt;ηᵢ(β,γ)=(x₍ᵢ₎−γ)/qᵢ^(1/β)&lt;br&gt;同一候选β、γ产生一组伪尺度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1000" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="mdm-1" value="先形成条件最小离散曲线&lt;br&gt;s(β,γ)=stdᵢ[ηᵢ(β,γ)]&lt;br&gt;固定γ：β*(γ)=argminβ s(β,γ)&lt;br&gt;s*(γ)=s[β*(γ),γ]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="1000" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="mdm-edge-1" value="" edge="1" parent="1" source="mdm-0" target="mdm-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mdm-2" value="再由梯度阈值和均值确定&lt;br&gt;g(γ)=ds*(γ)/dγ，按g(γ)=δ定位&lt;br&gt;约束γ≥0时：g(0)≥δ则γ̂=0&lt;br&gt;β̂=β*(γ̂)，η̂=meanᵢηᵢ(β̂,γ̂)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#2D6D91;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="1000" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="mdm-edge-2" value="" edge="1" parent="1" source="mdm-1" target="mdm-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#2D6D91;fontColor=#2D6D91;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>