        <mxCell id="joint-likelihood" value="\(L(\theta;D)=\prod_{i=1}^{n}f(x_i;\theta)\)&lt;br&gt;&lt;br&gt;\(=\frac{\beta^n}{\eta^{n\beta}}\prod_{i=1}^{n}y_i^{\beta-1}\)&lt;br&gt;&lt;br&gt;\(\quad\times\exp\!\left[-\sum_{i=1}^{n}\left(\frac{y_i}{\eta}\right)^\beta\right]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#AA5041;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
