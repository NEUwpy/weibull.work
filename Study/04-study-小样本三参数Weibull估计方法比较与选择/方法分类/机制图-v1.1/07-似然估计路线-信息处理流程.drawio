          <mxGeometry x="1310" y="305" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log-likelihood" value="\(\ell(\theta;D)=\ln L(\theta;D)\)&lt;br&gt;&lt;br&gt;\(=n\ln\beta-n\beta\ln\eta\)&lt;br&gt;&lt;br&gt;\(\quad+(\beta-1)\sum_{i=1}^{n}\ln y_i\)&lt;br&gt;&lt;br&gt;\(\quad-\sum_{i=1}^{n}\left(\frac{y_i}{\eta}\right)^\beta\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#357A63;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=29;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
