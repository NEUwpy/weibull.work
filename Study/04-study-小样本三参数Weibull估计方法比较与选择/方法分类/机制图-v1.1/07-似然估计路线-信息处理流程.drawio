        <mxCell id="same-model" value="同一个 Weibull 模型；\(z_i=(x_i-\gamma_0)/\eta_0\)&lt;br&gt;\(f(x_i;\beta,\eta_0,\gamma_0)=\frac{\beta}{\eta_0}z_i^{\beta-1}e^{-z_i^\beta}\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#6B7B8D;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=28;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
