<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="posterior-information-flow" name="后验推断｜用先验重加权似然，再以损失或密度峰决定估计">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1110" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="后验推断｜用先验重加权似然，再以损失或密度峰决定估计" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=35;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="20" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="先构造完整的参数后验；所选后验规则随后决定需要计算的目标。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="100" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-heading" value="后验怎样由观测和已有信息形成？" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="190" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-0" value="计算候选参数的样本支持&lt;br&gt;L(θ|D)=∏ᵢfθ(xᵢ)&lt;br&gt;π(θ)描述已有参数信息&lt;br&gt;同时限定模型与先验的允许域" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#785499;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-1" value="将样本贡献与先验权重相乘&lt;br&gt;q(θ)=L(θ|D)π(θ)&lt;br&gt;观测和先验共同改变&lt;br&gt;不同候选参数的相对权重" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#785499;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-edge-1" value="" edge="1" parent="1" source="posterior-build-0" target="posterior-build-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#785499;fontColor=#785499;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-2" value="积分归一化为参数后验&lt;br&gt;Z=∫q(θ)dθ&lt;br&gt;p(θ|D)=q(θ)/Z&lt;br&gt;积分在允许参数域内进行" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#785499;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="posterior-build-edge-2" value="" edge="1" parent="1" source="posterior-build-1" target="posterior-build-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#785499;fontColor=#785499;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="后验损失最小化&lt;br&gt;R(a|D)=∫损失(a,θ)p(θ|D)dθ&lt;br&gt;选择a使后验平均损失最小&lt;br&gt;平方损失→后验均值；逐参数绝对损失→边缘中位数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#785499;fillColor=#F6F0FB;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="95" y="700" width="1010" height="225" as="geometry" />
        </mxCell>
        <mxCell id="map" value="后验密度最大化（MAP）&lt;br&gt;θ̂MAP=argmaxθ p(θ|D)&lt;br&gt;=argmaxθ[lnL(θ|D)+lnπ(θ)]&lt;br&gt;选联合后验密度最高的候选" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#785499;fillColor=#F6F0FB;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=27;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1215" y="700" width="690" height="225" as="geometry" />
        </mxCell>
        <mxCell id="to-risk" value="" edge="1" parent="1" source="posterior-build-2" target="risk" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#785499;fontColor=#785499;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1680" y="580" />
              <mxPoint x="600" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="to-map" value="" edge="1" parent="1" source="posterior-build-2" target="map" style="html=1;rounded=0;strokeWidth=2.5;strokeColor=#785499;fontColor=#785499;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1680" y="625" />
              <mxPoint x="1560" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="calculation" value="积分、Gibbs／MH抽样、Laplace近似或优化，是计算相应后验量的路径；参数选择依据来自上述规则。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="50" y="1000" width="1900" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>