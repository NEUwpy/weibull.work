        <mxCell id="restore-rules" value="形状固定为 β̂ 后&lt;br&gt;&lt;br&gt;η̂ = 样本标准差&lt;br&gt;　　 ÷ 理论 sd(Y)&lt;br&gt;&lt;br&gt;γ̂ = x̄−η̂ E(Y)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
