        </mxCell>
        <mxCell id="cran-interface" value="①②换统计量：Cran改用生存积分矩；γ≥0时由矩差比反解。PWM／L矩／TL矩改排序权重。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1300" width="1890" height="50" as="geometry" />
        </mxCell>
        <mxCell id="wv-interface" value="②③换消元与准则：W消γ、η后以联合密度估β；V只消γ，先联合估η、β，再保留β恢复其余参数。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1350" width="1890" height="50" as="geometry" />
        </mxCell>
        <mxCell id="linear-interface" value="③④换成条件选权：给定β、η构造无偏位置量，再按协方差组合；未知时另以临时估计代入。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1400" width="1890" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notation" value="这里Y为尺度1、位置0的Weibull变量；平移、正尺度变换保持偏度不变。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
