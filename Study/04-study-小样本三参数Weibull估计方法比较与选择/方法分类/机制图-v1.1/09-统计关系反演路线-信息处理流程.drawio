        </mxCell>
        <mxCell id="interfaces-title" value="后续讲方法差异时，对照这些步骤" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=27;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="55" y="912" width="2290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cran-interface" value="①②换统计量：Cran改用生存积分矩；\(\gamma\geq0\)时由矩差比反解。PWM／L矩／TL矩改排序权重。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="970" width="2290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wv-interface" value="②③换消元与准则：\(W\)消\(\gamma\)、\(\eta\)后以联合密度估\(\beta\)；\(V\)只消\(\gamma\)，先联合估\(\eta\)、\(\beta\)，再保留\(\beta\)恢复其余参数。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1015" width="2290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="linear-interface" value="③④换成条件选权：给定\(\beta\)、\(\eta\)构造无偏位置量，再按协方差组合；未知时另以临时估计代入。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=24;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1060" width="2290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="notation" value="这里\(Y\)为尺度1、位置0的Weibull变量；平移、正尺度变换保持偏度不变。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=23;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="55" y="1105" width="2290" height="40" as="geometry" />
        </mxCell>
      </root>
