<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.9">
  <diagram id="statistics-information-flow" name="统计关系反演｜写出统计量如何依赖参数，再用消元或条件关系定参数">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1700" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="统计关系反演｜写出统计量如何依赖参数，再用消元或条件关系定参数" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=35;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="45" y="20" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="各行给出具体的统计量、模型关系与确定原则，展示不同的反演路径。" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
          <mxGeometry x="45" y="100" width="1910" height="65" as="geometry" />
        </mxCell>
        <mxCell id="moment-heading" value="常规矩：先用偏度消去位置与尺度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="190" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="moment-0" value="由观测计算样本矩&lt;br&gt;x̄=mean(xᵢ)&lt;br&gt;m₂=mean[(xᵢ−x̄)²]&lt;br&gt;m₃=mean[(xᵢ−x̄)³]&lt;br&gt;样本偏度ĝ=m₃/m₂^(3/2)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="moment-1" value="用模型消去γ、η&lt;br&gt;理论偏度g(β)只依赖β&lt;br&gt;理论方差=η²A₂(β)&lt;br&gt;A₂(β)=Γ(1+2/β)−Γ²(1+1/β)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="moment-edge-1" value="" edge="1" parent="1" source="moment-0" target="moment-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="moment-2" value="令样本与理论关系相等&lt;br&gt;解g(β)=ĝ确定β&lt;br&gt;η̂=√[m₂/A₂(β̂)]&lt;br&gt;γ̂=x̄−η̂Γ(1+1/β̂)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="260" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="moment-edge-2" value="" edge="1" parent="1" source="moment-1" target="moment-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cran-heading" value="Cran：改用生存曲线积分矩，以矩差比显式消元" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="550" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cran-0" value="对经验生存曲线求积分&lt;br&gt;μ̂ₖ=∫₀∞[1−Fₙ(x)]ᵏdx&lt;br&gt;取k=1、2、4&lt;br&gt;形成三个样本积分矩" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="620" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cran-1" value="理论矩差消去位置和尺度&lt;br&gt;γ≥0时：μₖ=γ+c·k^(−1/β)&lt;br&gt;c=ηΓ(1+1/β)&lt;br&gt;R=(μ₁−μ₂)/(μ₂−μ₄)=2^(1/β)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="620" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cran-edge-1" value="" edge="1" parent="1" source="cran-0" target="cran-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cran-2" value="以样本矩差比反解参数&lt;br&gt;R̂=(μ̂₁−μ̂₂)/(μ̂₂−μ̂₄)&lt;br&gt;β̂=ln2/ln R̂&lt;br&gt;再由任意两条μₖ关系解γ、η" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="620" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cran-edge-2" value="" edge="1" parent="1" source="cran-1" target="cran-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="invariance-heading" value="W／V：先移除干扰参数，再评价剩余信息的联合密度" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="910" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="invariance-0" value="由次序观测构造差与比&lt;br&gt;Wᵢ=(X₍ᵢ₎−X₍₁₎)/(X₍ₙ₎−X₍₁₎)&lt;br&gt;Vᵢ=X₍ᵢ₎−X₍₁₎&lt;br&gt;差消γ；标准化比值再消η" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="980" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="invariance-1" value="写出变换统计量的联合密度&lt;br&gt;W内部非退化分量：fW(w;β)&lt;br&gt;V非退化分量：fV(v;η,β)&lt;br&gt;保留各分量之间的相关结构" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="980" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="invariance-edge-1" value="" edge="1" parent="1" source="invariance-0" target="invariance-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="invariance-2" value="以联合密度最大点确定&lt;br&gt;W：最大化fW估β，再恢复η、γ&lt;br&gt;V：先联合最大化fV估η、β&lt;br&gt;下一阶段保留β，再恢复η、γ" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="980" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="invariance-edge-2" value="" edge="1" parent="1" source="invariance-1" target="invariance-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="linear-heading" value="条件位置估计：构造共同期望为γ的量，再以最小方差选权" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=28;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;fontStyle=1;" renderRole="label">
          <mxGeometry x="50" y="1270" width="1900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="linear-0" value="给定真实β、η时消去理论偏移&lt;br&gt;Tᵢ=X₍ᵢ₎−ηEβ[Y₍ᵢ₎]&lt;br&gt;E(Tᵢ)=γ，S=Cov(T)&lt;br&gt;形成一组无偏位置量" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="50" y="1340" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="linear-1" value="把线性组合的方差写成目标&lt;br&gt;γ̂=cᵀT&lt;br&gt;在1ᵀc=1下最小化cᵀSc&lt;br&gt;约束保持无偏，目标压低方差" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#F7F9FC;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="730" y="1340" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="linear-edge-1" value="" edge="1" parent="1" source="linear-0" target="linear-1" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="linear-2" value="由协方差决定组合系数&lt;br&gt;c=S⁻¹1/(1ᵀS⁻¹1)&lt;br&gt;再计算γ̂=cᵀT&lt;br&gt;参数未知时另以临时估计代入&lt;br&gt;并可接入参数恢复迭代" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#347B68;fillColor=#EDF5EF;fontColor=#243449;fontFamily=Microsoft YaHei;fontSize=25;spacing=12;align=center;verticalAlign=middle;strokeWidth=1.8;" renderRole="method">
          <mxGeometry x="1410" y="1340" width="540" height="210" as="geometry" />
        </mxCell>
        <mxCell id="linear-edge-2" value="" edge="1" parent="1" source="linear-1" target="linear-2" style="html=1;rounded=0;strokeWidth=3;strokeColor=#347B68;fontColor=#347B68;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" relationKind="flow" evidence="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>