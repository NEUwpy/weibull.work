        <mxCell id="restore-rules" value="\(\widehat{\eta}=\frac{\sqrt{m_2}}{\operatorname{sd}_{\widehat{\beta}}(Y)}\)&lt;br&gt;\(\widehat{\gamma}=\bar{x}-\widehat{\eta}\mathbb{E}_{\widehat{\beta}}[Y]\)" vertex="1" parent="1" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;strokeColor=#243449;fillColor=#FFFFFF;fontColor=#243449;fontFamily=Times New Roman;fontSize=26;spacing=12;align=left;verticalAlign=middle;strokeWidth=1.8;strokeColor=none;fillColor=none;" renderRole="label">
