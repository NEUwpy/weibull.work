          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-3" value="&amp;lt;b&amp;gt;K–R／DMMLE&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;最小值定位、删点与偏差修正组合；来源和作用环节分别记录。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
