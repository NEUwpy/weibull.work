          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-4" value="&amp;lt;b&amp;gt;CMLE／罚似然&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;替换边界处密度项或加入经验因子，改变边界处理而非简单换求解器。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
