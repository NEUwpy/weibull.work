          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-2" value="&amp;lt;b&amp;gt;MMLE 分支&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;以最小值、均值、方差或中位数关系替换部分位置方程；同名分支需分开。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
