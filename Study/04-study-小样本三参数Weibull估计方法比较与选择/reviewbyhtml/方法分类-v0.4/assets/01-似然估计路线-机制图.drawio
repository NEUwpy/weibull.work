          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-1" value="&amp;lt;b&amp;gt;WMLE&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;在估计方程中加入样本量相关权重，仍以似然方程为骨架。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
