        </mxCell>
        <mxCell id="sample" value="&amp;lt;b&amp;gt;① 样本 D&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;排序寿命样本&amp;lt;br&amp;gt;完整样本或指定观测条件" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#63758A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="40" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="info" value="&amp;lt;b&amp;gt;② 信息利用&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;观测处密度 f(tᵢ;β,η,γ)；位置参数决定支持边界，联合密度同时携带三参数信息。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#63758A;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="475" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="principle" value="&amp;lt;b&amp;gt;③ 参数确定原则&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;构造 L(θ|D) 或得分方程，最大化联合似然，或对其位置方程、权重和偏差项作明确修正。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="910" y="170" width="360" height="170" />
        </mxCell>
        <mxCell id="output" value="&amp;lt;b&amp;gt;④ 三参数估计&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;β̂、η̂、γ̂&amp;lt;br&amp;gt;并伴随边界、局部极大、失败与求解诊断" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#EEF8F2;strokeColor=#548A74;align=left;verticalAlign=middle;spacing=10;">
