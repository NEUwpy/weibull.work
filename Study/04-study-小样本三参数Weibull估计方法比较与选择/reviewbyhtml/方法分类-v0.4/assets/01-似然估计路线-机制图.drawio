        <mxCell id="branch-0" value="&amp;lt;b&amp;gt;原始 MLE&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;保留原始密度准则；区分局部候选、边界响应与全局存在性。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
