        <mxCell id="branches-panel" value="&amp;lt;b&amp;gt;主要构造与方法分支&amp;lt;/b&amp;gt;" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#63758A;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;">
          <mxGeometry as="geometry" x="40" y="385" width="1665" height="300" />
