          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1508" y="692" />
            <mxPoint as="targetPoint" x="1508" y="749" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="参数恢复" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#B44948;fontStyle=1;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry as="geometry" x="32" y="716" width="300" height="38" />
        </mxCell>
        <mxCell id="c26" value="$$\widehat\gamma\ \longrightarrow\ \widehat\beta=\beta^*(\widehat\gamma)\ \longrightarrow\ \widehat\eta=\frac1n\sum_i\eta_i(\widehat\beta,\widehat\gamma)$$" vertex="1" parent="1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F1D7D4;strokeColor=#B44948;fontFamily=Microsoft YaHei;fontColor=#263238;fontSize=28;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="32" y="760" width="1736" height="100" />
        </mxCell>
        <mxCell id="c27" value="关键区别：位置由梯度阈值确定，不是再取标准差曲线的最低点。曲线采用同一实际算例，δ为设定值。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#263238;fontStyle=0;align=left;verticalAlign=middle;spacing=0;">
          <mxGeometry as="geometry" x="32" y="879" width="1736" height="35" />
        </mxCell>
        <mxCell id="c28" value="依据：182-030／046与当前MDM-0.1；Research00报告1第48组存档寿命。图解内部交点，边界另记。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#7D8790;fontStyle=0;align=left;verticalAlign=middle;spacing=0;">
