        </mxCell>
        <mxCell id="c23" value="$$g(\widehat\gamma)=\frac{ds^*}{d\gamma}=\delta=0.1$$" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=27;fontColor=#B44948;fontStyle=0;align=left;verticalAlign=middle;spacing=0;">
