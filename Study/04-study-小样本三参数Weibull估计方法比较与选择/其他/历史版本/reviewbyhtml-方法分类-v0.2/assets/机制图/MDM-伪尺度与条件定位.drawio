        <mxCell id="c21" value="求梯度" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#263238;fontStyle=0;align=left;verticalAlign=middle;spacing=0;">
