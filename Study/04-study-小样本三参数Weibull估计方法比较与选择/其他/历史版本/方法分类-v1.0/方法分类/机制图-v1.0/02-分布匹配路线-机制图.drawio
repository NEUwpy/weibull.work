          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-1" value="&lt;b&gt;LSE／WLSE&lt;/b&gt;&lt;br&gt;在经验分布或变换关系上最小化残差；权重属于实现与改进标签。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="615" y="445" width="500" height="82" />
