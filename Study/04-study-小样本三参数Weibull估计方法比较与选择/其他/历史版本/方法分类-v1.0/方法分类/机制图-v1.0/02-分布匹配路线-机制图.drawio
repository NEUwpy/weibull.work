        <mxCell id="branch-edge-1" value="" parent="1" edge="1" source="principle" target="branch-1" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-2" value="&lt;b&gt;MPS／QMP&lt;/b&gt;&lt;br&gt;使用排序样本在理论CDF上的概率间距；MPS可作为特定QMP设置的特例。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="1160" y="445" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-2" value="" parent="1" edge="1" source="principle" target="branch-2" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-3" value="&lt;b&gt;MDM&lt;/b&gt;&lt;br&gt;比较每个观测反推的尺度伪估计是否一致；位置用条件差异曲线及梯度规则定位。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
          <mxGeometry as="geometry" x="70" y="550" width="500" height="82" />
        </mxCell>
        <mxCell id="branch-edge-3" value="" parent="1" edge="1" source="principle" target="branch-3" style="html=1;strokeColor=#B44948;strokeWidth=1.4;endArrow=open;endFill=1;rounded=0;dashed=1;dashPattern=6 4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-4" value="&lt;b&gt;CDF／密度／最小距离&lt;/b&gt;&lt;br&gt;直接把理论分布与经验对象比较；具体目标函数和支持条件需逐篇核对。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
