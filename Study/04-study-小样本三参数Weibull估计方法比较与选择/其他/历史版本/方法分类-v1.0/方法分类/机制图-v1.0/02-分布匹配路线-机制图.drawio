          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branches-panel" value="&lt;b&gt;主要构造与方法分支&lt;/b&gt;" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#263238;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#63758A;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;">
          <mxGeometry as="geometry" x="40" y="385" width="1665" height="300" />
        </mxCell>
        <mxCell id="branch-0" value="&lt;b&gt;概率图分支&lt;/b&gt;&lt;br&gt;White／Soman／Park：分数、位置判据、回归方向和参数恢复共同决定估计器。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
