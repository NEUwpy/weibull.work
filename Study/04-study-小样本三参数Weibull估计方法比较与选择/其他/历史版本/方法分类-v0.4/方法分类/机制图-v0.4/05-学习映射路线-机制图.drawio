        <mxCell id="branch-0" value="&lt;b&gt;直接参数映射&lt;/b&gt;&lt;br&gt;ANN／BPNN等从样本特征直接预测三个参数；训练数据和特征属于方法本身。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
