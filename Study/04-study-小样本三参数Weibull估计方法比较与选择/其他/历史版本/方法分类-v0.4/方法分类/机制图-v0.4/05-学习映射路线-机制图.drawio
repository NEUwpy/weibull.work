        </mxCell>
        <mxCell id="subtitle" value="核心问题：能否从训练样本中学习样本到参数的估计函数？" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#63758A;strokeWidth=0;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=0;">
