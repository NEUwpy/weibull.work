          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="branch-2" value="&lt;b&gt;训练域与泛化&lt;/b&gt;&lt;br&gt;参数范围、样本量、尺度处理和外推位置决定可声明边界。" parent="1" vertex="1" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#6F2F2B;strokeWidth=1.6;rounded=1;arcSize=8;fillColor=#FFF5F2;strokeColor=#B44948;align=left;verticalAlign=middle;spacing=10;">
