# Supply a newly rotated key on the deployment host. Never commit real values.
MOONSHOT_API_KEY=
CLOUDFLARE_TOKEN=

# Reliability library search expansion and grounded answers (server only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Server runtime data. Defaults to ../weibull-data beside the software checkout.
WEIBULL_DATA_ROOT=

# Optional explicit source/v1 library. Blank selects <data root>/literature.
# Local development uses literature-source to select the 100/400 canonical sources.
# External format and validation: docs/library/README.md
WEIBULL_LIBRARY_ROOT=
