# Supply a newly rotated key on the deployment host. Never commit real values.
MOONSHOT_API_KEY=
CLOUDFLARE_TOKEN=

# Reliability library search expansion and grounded answers (server only).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Server runtime data. Defaults to ../weibull-data beside the software checkout.
WEIBULL_DATA_ROOT=

# Optional explicit source/v1 library. Blank selects <data root>/literature.
# Local development uses literature-source to select the 100/400 canonical sources.
# External format and validation: docs/library/README.md
WEIBULL_LIBRARY_ROOT=

# Library login (server only). password keeps the existing single-account mode.
WEIBULL_LIBRARY_AUTH_MODE=password
WEIBULL_LIBRARY_PHONE=
WEIBULL_LIBRARY_PASSWORD_HASH=
WEIBULL_SESSION_SECRET=

# Required with WEIBULL_LIBRARY_AUTH_MODE=sms on NAS.
WEIBULL_SMS_ACCESS_KEY_ID=
WEIBULL_SMS_ACCESS_KEY_SECRET=
WEIBULL_SMS_SIGN_NAME=
WEIBULL_SMS_TEMPLATE_CODE=
# Optional six-digit code for loopback next dev only. Use a separate test data directory.
WEIBULL_SMS_LOCAL_CODE=

# Blank uses JSON for local Next.js development and SQLite in Docker Compose.
WEIBULL_FAVORITES_STORAGE=
# Optional writable private directory. Defaults to WEIBULL_DATA_ROOT/private/library-favorites.
WEIBULL_FAVORITES_DIR=
# Optional stable identity for an existing SQLite account, e.g. library-owner.
WEIBULL_LIBRARY_ACCOUNT_ID=
