{
  "methodId": "mdm",
  "methodName": "最小差异法 (MDM)",
  "description": "通过最小化伪尺度参数的标准差来估计参数，引入梯度偏移判据提高稳健性",
  "code": [
    "# MDM 算法：最小差异法",
    "# 输入: data - 原始失效时间样本",
    "# 输出: beta, eta, gamma - 威布尔分布参数",
    "",
    "import numpy as np",
    "from scipy.optimize import minimize_scalar",
    "",
    "# ========== 第1步：数据预处理 ==========",
    "# 去除无效值，排序数据",
    "t = np.array(sorted([x for x in data if x > 0]))",
    "n = len(t)",
    "",
    "# ========== 第2步：计算中位秩 ==========",
    "# 使用 Bernard 公式计算经验累积分布函数值",
    "ranks = (np.arange(1, n + 1) - 0.3) / (n + 0.4)",
    "neg_ln_1_minus_F = -np.log(1 - ranks)",
    "",
    "# ========== 第3步：初始化位置参数搜索范围 ==========",
    "# 设置 γ 的候选值范围，约束条件：γ < t₁",
    "t_min = t[0]",
    "gammas = np.linspace(0, t_min * 0.99, 60)",
    "",
    "# ========== 第4步：定义伪尺度参数计算函数 ==========",
    "# 计算给定 β 和 γ 下，每个样本点的伪尺度参数",
    "def compute_pseudo_eta(beta, gamma, t, neg_ln_1_minus_F):",
    "    denom = neg_ln_1_minus_F ** (1 / beta)",
    "    return (t - gamma) / denom",
    "",
    "# ========== 第5步：定义目标函数（标准差） ==========",
    "# 计算伪尺度参数的标准差",
    "def sigma_eta(beta, gamma, t, neg_ln_1_minus_F):",
    "    etas = compute_pseudo_eta(beta, gamma, t, neg_ln_1_minus_F)",
    "    return np.std(etas)",
    "",
    "# ========== 第6步：外层循环：遍历位置参数 γ ==========",
    "# 对每个 γ 候选值，记录最小的标准差及其对应的 β",
    "sigma_mins = []",
    "beta_for_gamma = []",
    "",
    "for gamma in gammas:",
    "    # 内层优化：寻找使标准差最小的 β",
    "    result = minimize_scalar(",
    "        lambda beta: sigma_eta(beta, gamma, t, neg_ln_1_minus_F),",
    "        bounds=(0.5, 10.0),",
    "        method='bounded'",
    "    )",
    "    sigma_mins.append(result.fun)",
    "    beta_for_gamma.append(result.x)",
    "",
    "# ========== 第7步：计算梯度 ==========",
    "# 计算 σ_min(γ) 关于 γ 的梯度（一阶导数）",
    "grads = np.gradient(sigma_mins, gammas)",
    "",
    "# ========== 第8步：梯度偏移判据寻优 ==========",
    "# 寻找梯度等于偏移值 δ=0.1 的点（而非导数为0的点）",
    "delta = 0.1",
    "# 使用线性插值找到梯度与阈值的交点",
    "found_gamma = np.interp(delta, grads, gammas)",
    "# 找到对应的 β 值",
    "found_beta = np.interp(found_gamma, gammas, beta_for_gamma)",
    "",
    "# ========== 第9步：计算最终尺度参数 η ==========",
    "# 使用最优的 γ* 和 β* 计算所有伪尺度参数的均值",
    "denom = neg_ln_1_minus_F ** (1 / found_beta)",
    "etas = (t - found_gamma) / denom",
    "found_eta = np.mean(etas)",
    "",
    "# ========== 第10步：计算拟合优度 R² ==========",
    "# 评估模型与数据的拟合程度",
    "F_pred = 1 - np.exp(-((t - found_gamma) / found_eta) ** found_beta)",
    "F = (np.arange(1, n + 1) - 0.3) / (n + 0.4)",
    "r2 = 1 - np.sum((F - F_pred) ** 2) / np.sum((F - np.mean(F)) ** 2)",
    "",
    "# ========== 输出结果 ==========",
    "return [found_beta, found_eta, found_gamma, r2, 'success']"
  ],
  "steps": [
