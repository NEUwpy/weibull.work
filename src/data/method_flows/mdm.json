{
  "methodId": "mdm",
  "methodName": "最小差异法 (MDM)",
  "description": "通过最小化伪尺度参数的标准差来估计参数，使用 g(0) 探测、近 t_min 右端括弧和 Brent 定根确定位置参数，并在交点落到 gamma<0 时按 gamma>=0 约束截断。",
  "code": [
    "# S4.9.3 MDM：离散 trace + g(0) 探测 + 右端括弧 + Brent 定根",
    "import numpy as np",
    "from scipy.optimize import minimize_scalar, root_scalar",
    "",
    "# ========== 第1步：数据预处理 ==========",
    "t = np.array(sorted([x for x in data if x > 0]))",
    "n = len(t)",
    "t_min = t[0]",
    "",
    "# ========== 第2步：计算中位秩 ==========",
    "ranks = (np.arange(1, n + 1) - 0.3) / (n + 0.4)",
    "x = -np.log(1 - ranks)",
    "",
    "# ========== 第3步：从 t_min 向 0 构造离散 gamma 网格 ==========",
    "def build_gamma_grid(t_min, gamma_steps):",
    "    min_gap = max(abs(t_min) * 1e-9, 1e-12)",
    "    gaps = np.geomspace(min_gap, t_min, gamma_steps)",
    "    gammas = t_min - gaps",
    "    gammas[0] = t_min - min_gap",
    "    gammas[-1] = 0.0",
    "    return gammas",
    "",
    "gammas = build_gamma_grid(t_min, gamma_steps)",
    "",
    "# ========== 第4步：定义伪尺度参数标准差 ==========",
    "def sigma_eta(beta, gamma):",
    "    eta_i = (t - gamma) / (x ** (1 / beta))",
    "    return np.std(eta_i, ddof=1)",
    "",
    "# ========== 第5步：给定 gamma，寻找最优 beta ==========",
    "def best_beta_for_gamma(gamma):",
    "    result = minimize_scalar(",
    "        lambda beta: sigma_eta(beta, gamma),",
    "        bounds=(0.1, 15.0),",
    "        method='bounded'",
    "    )",
    "    return result.x, result.fun",
    "",
    "# ========== 第6步：外层离散采样 gamma ==========",
    "sigma_mins = []",
    "best_betas = []",
    "for gamma in gammas:",
    "    beta, sigma_min = best_beta_for_gamma(gamma)",
    "    sigma_mins.append(sigma_min)",
    "    best_betas.append(beta)",
    "",
    "# ========== 第7步：用求解器同源函数计算廓线梯度 ==========",
    "def profile_gradient(gamma):",
    "    # 与后端求解器一致：对 profile sigma 做稳定有限差分",
    "    return finite_difference(lambda g: best_beta_for_gamma(g)[1], gamma)",
    "",
    "grads = np.array([profile_gradient(gamma) for gamma in gammas])",
    "diffs = grads - offset",
    "",
    "# ========== 第8步：同源采样曲线记录交点诊断 ==========",
    "legacy_grid_crossing = None",
    "for i in range(len(diffs) - 1):",
    "    if diffs[i] == 0 or diffs[i + 1] == 0 or diffs[i] * diffs[i + 1] < 0:",
    "        legacy_grid_crossing = (i, i + 1)",
    "        break",
    "",
    "# ========== 第9步：g(0) 探测 + 右端括弧 + Brent 定根 ==========",
    "probe_gradient_at_zero = profile_gradient(0.0)",
    "if probe_gradient_at_zero >= offset:",
    "    found_gamma = 0.0",
    "    solution_strategy = 'truncated_at_zero'",
    "else:",
    "    right_gamma, right_gradient = find_right_anchor_near_t_min()",
    "    # 即使当前右端锚点仍低于 offset，也按 S4.9.3 向 t_min 近端补出交点",
    "    root = solve_offset_root_from_right_edge(",
    "        left_gamma=0.0,",
    "        right_grid_gamma=right_gamma,",
    "        right_grid_gradient=right_gradient,",
    "        t_min=t_min,",
    "        offset=offset",
    "    )",
    "    found_gamma = root.gamma",
    "    solution_strategy = 'brent_root'",
    "",
    "# ========== 第10步：计算最终 beta、eta、R²，并返回 trace ==========",
    "found_beta, _ = best_beta_for_gamma(found_gamma)",
    "eta_i = (t - found_gamma) / (x ** (1 / found_beta))",
    "found_eta = np.mean(eta_i)",
    "r2 = calculate_r2(found_beta, found_eta, found_gamma)",
    "",
    "trace_data = {",
    "    'grad_gamma_curve': build_solver_trace_curve(gammas, grads, found_gamma, offset),",
    "    'search_strategy': 'geometric_from_tmin',",
    "    'solution_strategy': solution_strategy,",
    "    'constraint': 'gamma >= 0',",
    "    'legacy_grid_crossing': legacy_grid_crossing,",
    "    'gamma_steps': gamma_steps",
    "}",
    "",
    "return found_beta, found_eta, found_gamma, r2, True"
  ],
  "steps": [
