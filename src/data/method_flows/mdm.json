      ],
      "formula": {
        "expression": "\\eta_i = \\frac{t_i - \\gamma}{x_i^{1/\\beta}}, \\quad \\sigma_\\eta = \\operatorname{std}(\\eta_1,\\ldots,\\eta_n)",
