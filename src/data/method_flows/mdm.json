    },
    {
      "id": 10,
      "name": "计算最终尺度参数 η",
      "description": "使用最优的 γ* 和 β* 计算所有伪尺度参数的均值",
      "formula": {
        "expression": "\\hat{\\eta} = \\frac{1}{n}\\sum_{i=1}^n \\frac{t_i - \\hat{\\gamma}}{x_i^{1/\\hat{\\beta}}}",
        "symbols": [
          {
            "symbol": "\\hat{\\eta}",
            "meaning": "尺度参数估计值"
          }
        ],
        "explanation": "使用最优的 γ* 和 β* 计算所有伪尺度参数的均值"
      },
      "inputs": [
        {
          "code": "found_gamma",
          "symbol": "\\hat{\\gamma}",
          "meaning": "最优γ"
        },
        {
          "code": "found_beta",
          "symbol": "\\hat{\\beta}",
          "meaning": "最优β"
        },
        {
          "code": "t",
          "symbol": "t",
          "meaning": "失效时间数组"
        }
      ],
      "outputs": [
        {
          "code": "found_eta",
          "symbol": "\\hat{\\eta}",
          "meaning": "尺度参数估计值"
        }
      ],
      "basis": "方法构造：在选定β、γ后，以伪尺度的均值恢复η。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 11 | 计算最终尺度参数 η | 使用最优的 γ* 和 β* 计算所有伪尺度参数的均值",
          "until": "# @step: 12 | 计算拟合优度 R² | 评估模型与数据的拟合程度"
        }
      ]
    },
    {
      "id": 11,
      "name": "计算拟合优度 R²",
      "description": "评估模型与数据的拟合程度",
      "formula": {
        "expression": "y_i=\\ln[-\\ln(1-p_i)],\\quad \\hat y_i=\\beta\\ln(t_i-\\gamma)-\\beta\\ln\\eta,\\quad R^2=1-\\frac{\\sum_i(y_i-\\hat y_i)^2}{\\sum_i(y_i-\\bar y)^2}",
        "explanation": "R²在双对数概率图空间计算，pᵢ来自当前 rank_method；不是原始CDF空间的残差。",
        "symbols": [
          {
            "symbol": "R^2",
            "meaning": "概率图决定系数"
          },
          {
            "symbol": "p_i",
            "meaning": "绘图位置"
          },
          {
            "symbol": "y_i",
            "meaning": "变换后的经验值"
          },
          {
            "symbol": "\\hat y_i",
            "meaning": "参数预测值"
          }
        ]
      },
      "inputs": [
        {
          "code": "found_beta",
          "symbol": "\\hat{\\beta}",
          "meaning": "形状参数"
        },
        {
          "code": "found_eta",
          "symbol": "\\hat{\\eta}",
          "meaning": "尺度参数"
        },
        {
          "code": "found_gamma",
          "symbol": "\\hat{\\gamma}",
          "meaning": "位置参数"
        }
      ],
      "outputs": [
        {
          "code": "r2",
          "symbol": "R^2",
          "meaning": "拟合优度"
        }
      ],
      "basis": "项目诊断：共用基础类的概率图 R²，不参与核心参数求解。",
      "notes": "γ触及样本最小值或总平方和为零时返回0；普通情况下允许负R²。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 12 | 计算拟合优度 R² | 评估模型与数据的拟合程度",
          "until": "# @step: 13 | 生成追踪数据 | 若启用 trace，生成用于可视化的详细数据"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase._calculate_r2",
          "label": "概率图 R²"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase._median_ranks",
          "label": "绘图位置"
