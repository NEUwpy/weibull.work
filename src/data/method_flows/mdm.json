{
  "schemaVersion": 2,
  "methodId": "mdm",
  "methodName": "最小差异法 (MDM)",
  "description": "伪尺度离散度 → 条件形状优化 → 梯度偏移定位 → 尺度恢复。",
  "steps": [
    {
      "id": 1,
      "name": "数据预处理",
      "description": "获取排序后的失效时间数据和样本数量",
      "formula": {
        "expression": "t_{(1)} \\leq t_{(2)} \\leq \\cdots \\leq t_{(n)}",
        "symbols": [
          {
            "symbol": "t",
            "meaning": "排序后的失效时间数组"
          },
          {
            "symbol": "n",
            "meaning": "样本数量"
          }
        ],
        "explanation": "获取排序后的失效时间数据和样本数量"
      },
      "inputs": [
        {
          "code": "data",
          "symbol": "t_i",
          "meaning": "原始失效时间样本"
        }
      ],
      "outputs": [
        {
          "code": "t",
          "symbol": "t",
          "meaning": "排序后数组"
        },
        {
          "code": "n",
          "symbol": "n",
          "meaning": "样本数量"
        }
      ],
      "basis": "公共输入规则：有限、严格为正的失效时间，统一排序。",
      "notes": "当前实现处理完整失效样本；不包含删失样本似然。offset 为必填求解控制量；默认使用 Bernard 秩，可选择 exact。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 1 | 数据预处理 | 获取排序后的失效时间数据和样本数量",
          "until": "# @step: 2 | 计算中位秩 | 使用 Bernard 公式计算经验累积分布函数值"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase.__init__",
          "label": "输入校验与排序"
        }
      ]
    },
    {
      "id": 2,
      "name": "计算中位秩",
      "description": "使用 Bernard 公式计算经验累积分布函数值",
      "formula": {
        "expression": "F(t_i) = \\frac{i - 0.3}{n + 0.4}, \\quad x_i = -\\ln(1 - F(t_i))",
        "symbols": [
          {
            "symbol": "F(t_i)",
            "meaning": "第i个样本点的经验累积概率"
          },
          {
            "symbol": "x_i",
            "meaning": "变换后的中位秩"
          }
        ],
        "explanation": "使用 Bernard 公式计算经验累积分布函数值"
      },
      "inputs": [
        {
          "code": "t",
          "symbol": "t",
          "meaning": "失效时间数组"
        },
        {
          "code": "n",
          "symbol": "n",
          "meaning": "样本数量"
        }
      ],
      "outputs": [
        {
          "code": "ranks",
          "symbol": "F(t_i)",
          "meaning": "中位秩数组"
        },
        {
          "code": "neg_ln_1_minus_F",
          "symbol": "x_i",
          "meaning": "变换数组"
        }
      ],
      "basis": "方法构造：以中位秩变换得到伪尺度计算的经验分数。",
      "notes": "所示主公式为默认 Bernard；exact 分支使用 Beta 分布中位数，见绘图位置源码。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 2 | 计算中位秩 | 使用 Bernard 公式计算经验累积分布函数值",
          "until": "# @step: 3 | 定义伪尺度参数计算函数 | 计算给定 β 和 γ 下每个样本点的伪尺度参数及其标准差"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase._median_ranks",
          "label": "绘图位置"
        }
      ]
    },
    {
      "id": 3,
      "name": "定义伪尺度参数计算函数",
      "description": "计算给定 β 和 γ 下每个样本点的伪尺度参数及其标准差",
      "formula": {
        "expression": "\\eta_i = \\frac{t_i - \\gamma}{x_i^{1/\\beta}}, \\quad \\sigma_\\eta = \\text{std}(\\eta_1, \\eta_2, \\ldots, \\eta_n)",
        "symbols": [
          {
            "symbol": "\\eta_i",
            "meaning": "第i个伪尺度参数"
          },
          {
            "symbol": "\\sigma_\\eta",
            "meaning": "伪尺度参数标准差"
          },
          {
            "symbol": "\\beta",
            "meaning": "形状参数"
          },
          {
            "symbol": "\\gamma",
            "meaning": "位置参数"
          }
        ],
        "explanation": "计算给定 β 和 γ 下每个样本点的伪尺度参数及其标准差"
      },
      "inputs": [
        {
          "code": "beta",
          "symbol": "\\beta",
          "meaning": "形状参数"
        },
        {
          "code": "gamma",
          "symbol": "\\gamma",
          "meaning": "位置参数"
        },
        {
          "code": "t",
          "symbol": "t",
          "meaning": "失效时间数组"
        }
      ],
      "outputs": [
        {
          "code": "np.std(etas, ddof=1)",
          "symbol": "\\sigma_\\eta",
          "meaning": "样本标准差（分母 n−1）"
        }
      ],
      "basis": "MDM 核心准则：使各样本伪尺度的样本标准差最小。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 3 | 定义伪尺度参数计算函数 | 计算给定 β 和 γ 下每个样本点的伪尺度参数及其标准差",
          "until": "# @step: 4 | 定义最优 β 搜索函数 | 对给定 γ，使用有界优化寻找使标准差最小的 β"
        }
      ]
    },
    {
      "id": 4,
      "name": "定义最优 β 搜索函数",
      "description": "对给定 γ，使用有界优化寻找使标准差最小的 β",
      "formula": {
        "expression": "\\beta^*(\\gamma) = \\arg\\min_{\\beta \\in [0.1, 15.0]} \\sigma_\\eta(\\beta, \\gamma)",
        "symbols": [
          {
            "symbol": "\\beta^*(\\gamma)",
            "meaning": "给定γ时的最优β"
          }
        ],
        "explanation": "对给定 γ，使用有界优化寻找使标准差最小的 β"
      },
      "inputs": [
        {
          "code": "gamma",
          "symbol": "\\gamma",
          "meaning": "位置参数候选值"
        }
      ],
      "outputs": [
        {
          "code": "best_beta",
          "symbol": "\\beta^*",
          "meaning": "最优β值"
        },
        {
          "code": "min_sigma",
          "symbol": "\\sigma_{min}",
          "meaning": "最小标准差"
        }
      ],
      "basis": "数值策略：每个位置候选调用有界标量优化并缓存结果。",
      "notes": "β∈[0.1,15]是当前工程搜索范围，不是所有MDM版本的普遍理论约束。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run.find_best_beta_for_gamma",
          "label": "条件形状优化"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run.calculate_eta_std",
          "label": "伪尺度目标函数"
        }
      ]
    },
    {
      "id": 5,
      "name": "位置约束与最小样本",
      "description": "读取最小失效时间，作为位置搜索的右端支撑边界。",
      "formula": {
        "expression": "t_{\\min}=\\min_i t_i,\\quad0\\le\\gamma<t_{\\min}",
        "explanation": "读取最小失效时间，作为位置搜索的右端支撑边界。",
        "symbols": [
          {
            "symbol": "t_{\\min}",
            "meaning": "最小失效时间"
          },
          {
            "symbol": "\\gamma",
            "meaning": "非负位置参数"
          }
        ]
      },
      "inputs": [
        {
          "code": "t",
          "symbol": "t",
          "meaning": "失效时间数组"
        }
      ],
      "outputs": [
        {
          "code": "t_min",
          "symbol": "t_{\\min}",
          "meaning": "最小失效时间"
        }
      ],
      "basis": "工程约束：位置参数只搜索 0≤γ<t₍₁₎。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 5 | 初始化搜索范围 | 设置 γ 的离散候选网格，约束条件：0 <= γ < t_min",
          "until": "# @step: 6 | 离散搜索 | 从接近 t_min 的位置向 0 展开几何加密网格，记录每个 γ 对应的最小标准差和最优 β"
        }
      ]
    },
    {
      "id": 6,
      "name": "离散搜索",
      "description": "从接近 t_min 的位置向 0 展开几何加密网格，记录每个 γ 对应的最小标准差和最优 β",
      "formula": {
        "expression": "\\sigma_{\\min}(\\gamma) = \\min_\\beta \\sigma_\\eta(\\beta, \\gamma)",
        "symbols": [
          {
            "symbol": "\\sigma_{\\min}",
            "meaning": "对形状优化后的伪尺度标准差"
          },
          {
            "symbol": "\\gamma",
            "meaning": "位置网格点"
          }
        ],
        "explanation": "从接近 t_min 的位置向 0 展开几何加密网格，记录每个 γ 对应的最小标准差和最优 β"
      },
      "inputs": [
        {
          "code": "t_min",
          "symbol": "t_{\\min}",
          "meaning": "最小失效时间"
        },
        {
          "code": "gamma_steps",
          "symbol": "N",
          "meaning": "搜索步数"
        }
      ],
      "outputs": [
        {
          "code": "gammas",
          "symbol": "\\gamma",
          "meaning": "γ候选值数组"
        },
        {
          "code": "sigma_mins",
          "symbol": "\\sigma_{min}",
          "meaning": "最小标准差数组"
        },
        {
          "code": "best_betas",
          "symbol": "\\beta^*",
          "meaning": "最优β数组"
        }
      ],
      "basis": "诊断采样：记录廓线形状；最终定位采用第9步的梯度方程。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 6 | 离散搜索 | 从接近 t_min 的位置向 0 展开几何加密网格，记录每个 γ 对应的最小标准差和最优 β",
          "until": "# @step: 7 | 计算廓线梯度 | 使用与求解器相同的 profile_gradient 计算 g(gamma)"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "_build_geometric_gamma_grid",
          "label": "几何网格"
        }
      ],
      "isLoop": true,
      "loopCount": "gamma_steps 次 (默认 60)"
    },
    {
      "id": 7,
      "name": "计算廓线梯度",
      "description": "使用与求解器相同的 profile_gradient 计算 g(gamma)",
      "formula": {
        "expression": "g(\\gamma) = \\frac{\\partial \\sigma_{\\min}(\\gamma)}{\\partial \\gamma}",
        "symbols": [
          {
            "symbol": "\\nabla",
            "meaning": "梯度值"
          }
        ],
        "explanation": "使用与求解器相同的 profile_gradient 计算 g(gamma)"
      },
      "inputs": [
        {
          "code": "gammas",
          "symbol": "\\gamma_j",
          "meaning": "候选位置"
        },
        {
          "code": "profile_sigma",
          "symbol": "\\sigma_{\\min}",
          "meaning": "条件优化后的标准差函数"
        }
      ],
      "outputs": [
        {
          "code": "grads",
          "symbol": "\\nabla",
          "meaning": "梯度数组"
        }
      ],
      "basis": "数值策略：内部点中心差分，靠近端点时使用单边差分。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run.profile_gradient",
          "label": "差分与步长"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run.profile_sigma",
          "label": "廓线函数"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 7 | 计算廓线梯度 | 使用与求解器相同的 profile_gradient 计算 g(gamma)",
          "until": "# @step: 8 | 离散曲线诊断 | 保留离散梯度曲线用于 trace，可视化和历史对照"
        }
      ]
    },
    {
      "id": 8,
      "name": "离散曲线诊断",
      "description": "保留离散梯度曲线用于 trace，可视化和历史对照",
      "formula": {
        "expression": "\\nabla(\\gamma^*) = \\delta",
        "symbols": [
          {
            "symbol": "\\delta",
            "meaning": "偏移阈值(offset)"
          }
        ],
        "explanation": "保留离散梯度曲线用于 trace，可视化和历史对照"
      },
      "inputs": [
        {
          "code": "grads",
          "symbol": "\\nabla",
          "meaning": "梯度数组"
        },
        {
          "code": "offset",
          "symbol": "\\delta",
          "meaning": "偏移阈值"
        }
      ],
      "outputs": [
        {
          "code": "root_info",
          "symbol": "root",
          "meaning": "交点插值结果"
        },
        {
          "code": "diffs",
          "symbol": "\\nabla-\\delta",
          "meaning": "梯度差值数组"
        }
      ],
      "basis": "诊断输出：离散交点供曲线与历史对照，不直接作为最终解。",
      "notes": "有多个离散交点时选择最靠近样本最小值的一段。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 8 | 离散曲线诊断 | 保留离散梯度曲线用于 trace，可视化和历史对照",
          "until": "# @step: 9 | 始终有解求解器 | 探测 g(0)，近 t_min 构造右端括弧，Brent 定根或边界截断"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "_find_offset_crossing",
          "label": "离散交点插值"
        }
      ]
    },
    {
      "id": 9,
      "name": "偏移方程与边界处理",
      "description": "先探测零位置梯度，再构造近右端括弧；可括根时用 Brent，否则采用右端近似。",
      "formula": {
        "expression": "g(0)\\ge\\delta \\Rightarrow \\hat{\\gamma}=0;\\quad g(0)<\\delta \\Rightarrow g(\\hat{\\gamma})=\\delta",
        "symbols": [
          {
            "symbol": "\\gamma^*",
            "meaning": "最优位置参数"
          }
        ],
        "explanation": "探测 g(0)，近 t_min 构造右端括弧，Brent 定根或边界截断"
      },
      "inputs": [
        {
          "code": "profile_gradient",
          "symbol": "g(\\gamma)",
          "meaning": "廓线梯度函数"
        },
        {
          "code": "offset",
          "symbol": "\\delta",
          "meaning": "要求的梯度偏移"
        }
      ],
      "outputs": [
        {
          "code": "found_gamma",
          "symbol": "\\gamma^*",
          "meaning": "最优γ值"
        },
        {
          "code": "solution_strategy",
          "symbol": "strategy",
          "meaning": "求解策略"
        }
      ],
      "basis": "工程求解规则：零边界截断、Brent定根及右端点近似分别记录。",
      "notes": "right_edge_fit 是逼近右端的工程返回，不是经Brent求得的精确偏移根；源码保留原有策略标签。",
      "sources": [
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run",
          "label": "本步实现",
          "from": "# @step: 9 | 始终有解求解器 | 探测 g(0)，近 t_min 构造右端括弧，Brent 定根或边界截断",
          "until": "# @step: 11 | 计算最终尺度参数 η | 使用最优的 γ* 和 β* 计算所有伪尺度参数的均值"
        },
        {
          "file": "python/methods/mdm.py",
          "symbol": "MDM.run.find_right_anchor",
