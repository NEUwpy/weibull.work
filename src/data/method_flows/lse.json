      "formula": {
        "expression": "\\hat{\\gamma}_{grid} = \\arg\\max_{\\gamma_j} F(\\gamma_j)",
        "symbols": [
          {
            "symbol": "\\gamma_j",
            "meaning": "位置参数候选网格"
