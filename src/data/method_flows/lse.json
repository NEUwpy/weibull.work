          "symbol": "log_weibull_order_stat_means",
          "label": "期望数组与缓存"
        },
        {
          "file": "python/methods/lse.py",
          "symbol": "LSE.run",
          "label": "本步实现",
          "from": "# @step: 2 | 计算顺序统计量期望 | 计算 reduced Log-Weibull 分布的 i 阶顺序统计量一阶矩（White 1969）",
          "until": "# @step: 3 | 定义 White 回归与 F 比 | 对给定 μ，拟合 log(t-μ) = α + βX 并计算 Fisher F 比"
        }
      ]
    },
    {
      "id": 3,
      "name": "定义 White 回归与 F 比",
      "description": "对给定 γ，拟合 log(t-γ) = α + βX 并计算 Fisher F 比",
      "formula": {
        "expression": "\\begin{gathered}Y_i=\\ln(t_i-\\gamma)=a+bX_i\\\\[5pt] b=\\frac{\\sum(X_i-\\bar X)(Y_i-\\bar Y)}{\\sum(X_i-\\bar X)^2}\\\\[5pt] F=\\frac{\\sum(Y_i-\\bar Y)^2/(n-1)}{\\sum(Y_i-a-bX_i)^2/(n-2)}\\end{gathered}",
        "explanation": "代码中的mu对应γ，slope对应b=1/β，intercept对应a=lnη。",
        "symbols": [
          {
            "symbol": "a,b",
            "meaning": "回归截距与斜率"
          },
          {
            "symbol": "F",
            "meaning": "用于定位的方差比"
          },
          {
            "symbol": "Y_i",
            "meaning": "平移后对数寿命"
          }
        ]
      },
      "inputs": [
        {
          "code": "X",
          "symbol": "X_i",
          "meaning": "顺序统计量期望"
        },
        {
          "code": "t",
          "symbol": "t_i",
          "meaning": "排序寿命"
        },
        {
          "code": "mu",
          "symbol": "\\gamma",
          "meaning": "位置候选"
        }
      ],
      "outputs": [
        {
          "code": "slope",
          "symbol": "b=1/\\beta",
          "meaning": "回归斜率"
        },
        {
          "code": "intercept",
          "symbol": "a=\\ln\\eta",
          "meaning": "回归截距"
        },
        {
          "code": "s_y2 / s_res2",
          "symbol": "F",
          "meaning": "方差比"
        }
      ],
      "basis": "White回归构造：斜率是1/β；F比的总方差用n−1、残差方差用n−2。",
      "notes": "无正平移距离、近全等对数样本、非正斜率等返回None；零残差返回无穷F，外层仍有有效性检查。",
      "sources": [
        {
          "file": "python/methods/lse.py",
          "symbol": "LSE.run",
          "label": "本步实现",
