          "until": "# @step: 2 | 计算顺序统计量期望 | 计算 reduced Log-Weibull 分布的 i 阶顺序统计量一阶矩（White 1969）"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase.__init__",
          "label": "输入校验与排序"
        }
      ]
    },
    {
      "id": 2,
      "name": "计算顺序统计量期望",
      "description": "计算 reduced Log-Weibull 分布的 i 阶顺序统计量一阶矩（White 1969）",
      "formula": {
        "expression": "X_i=\\int_{-\\infty}^{\\infty}w\\,\\frac{n!}{(i-1)!(n-i)!}H(w)^{i-1}[1-H(w)]^{n-i}h(w)\\,dw,\\quad H(w)=1-e^{-e^w},\\quad h(w)=e^{w-e^w}",
        "explanation": "程序以数值积分求顺序统计量期望，并按n缓存。积分截断和稳定化见源码。",
        "symbols": [
          {
            "symbol": "X_i",
            "meaning": "顺序统计量期望"
          },
          {
            "symbol": "H,h",
            "meaning": "reduced Log-Weibull分布函数与密度"
          },
          {
            "symbol": "n,i",
            "meaning": "样本量与顺序"
          }
        ]
      },
      "inputs": [
        {
          "code": "n",
          "symbol": "n",
          "meaning": "样本数量"
        }
      ],
      "outputs": [
