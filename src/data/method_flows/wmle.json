{
  "methodId": "wmle",
  "methodName": "加权极大似然估计 (WMLE)",
  "description": "通过引入三个权重 (W₁, W₂, W₃) 修正 MLE 在小样本下的偏差，偏差减少 7 倍",
  "code": [
    "# WMLE 算法：加权极大似然估计",
    "# 输入: data - 原始失效时间样本",
    "# 输出: beta, eta, gamma - 威布尔分布参数",
    "",
    "import numpy as np",
    "from scipy.optimize import minimize",
    "",
    "# ========== 第1步：数据预处理 ==========",
    "# 去除无效值，排序数据",
    "arr = np.array(sorted([x for x in data if x > 0]))",
    "n = len(arr)",
    "",
    "# ========== 第2步：计算静态权重 W₁, W₂ ==========",
    "# 根据样本量 n 从权重表中查取或计算两个静态修正权重",
    "w1 = np.exp(np.math.digamma(n)) / n  # 或使用查表: get_weight_j1(n)",
    "w2 = max(0, 1 - 1/n)",
    "",
    "# ========== 第3步：初始化搜索起点 ==========",
    "# 为数值优化算法设置初始猜测值",
    "gamma_init = 2.0",
    "alpha_init = arr[0] * 0.95",
    "",
    "# ========== 第4步：定义目标函数（WMLE 方程） ==========",
    "# 构造包含两个平方项的目标函数",
    "def wmle_objective(params):",
    "    gamma, alpha = params  # gamma=β(形状), alpha=γ(位置)",
    "    ",
    "    # T₁项：修正的位置参数似然方程",
    "    log_term = np.mean(np.log(arr - alpha))",
    "    moment_term = np.mean((arr - alpha) ** gamma) / np.mean((arr - alpha) ** (gamma - 1))",
    "    t1 = (w2 / gamma + log_term - moment_term) ** 2",
    "    ",
    "    # 动态计算权重 W₃",
    "    log_reciprocal = np.log(1 / (1 - np.arange(1, n + 1) / (n + 1)))",
    "    mean_log = np.mean(log_reciprocal)",
    "    w3 = gamma / (gamma - 1) * (1 - 1 / (n * np.exp(-gamma * mean_log)))",
    "    ",
    "    # T₂项：修正的形状参数似然方程",
    "    harmonic_mean = 1 / np.mean(1 / (arr - alpha))",
    "    t2 = (harmonic_mean - w3) ** 2",
    "    ",
    "    return t1 + t2",
    "",
    "# ========== 第5步：数值优化（Nelder-Mead） ==========",
    "# 使用无导数优化算法搜索使目标函数最小的 γ 和 α",
    "result = minimize(",
    "    wmle_objective,",
    "    [gamma_init, alpha_init],",
    "    method='Nelder-Mead',",
    "    options={'maxiter': 500, 'xatol': 1e-8, 'fatol': 1e-8}",
    ")",
    "",
    "# ========== 第6步：代数计算尺度参数 η ==========",
    "# 使用最优的 γ* 和 α*，通过加权代数公式直接计算 η",
    "beta_hat = 2.0  # WMLE 使用固定形状参数2.0（也可优化得到）",
    "gamma_hat, alpha_hat = result.x",
    "x_adj = arr - gamma_hat",
    "eta_hat = (np.sum(x_adj ** beta_hat) / (n * w1)) ** (1 / beta_hat)",
    "",
    "# ========== 第7步：计算拟合优度 R² ==========",
    "# 评估模型与数据的拟合程度",
    "F_pred = 1 - np.exp(-((arr - gamma_hat) / eta_hat) ** beta_hat)",
    "F = (np.arange(1, n + 1) - 0.3) / (n + 0.4)",
    "r2 = 1 - np.sum((F - F_pred) ** 2) / np.sum((F - np.mean(F)) ** 2)",
    "",
    "# ========== 输出结果 ==========",
    "return [beta_hat, eta_hat, gamma_hat, r2, 'success']"
  ],
  "steps": [
    {
