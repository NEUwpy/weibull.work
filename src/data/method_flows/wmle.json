        },
        {
          "code": "gamma",
          "symbol": "γ",
          "meaning": "位置候选"
        }
      ],
      "outputs": [
        {
          "code": "t1",
          "symbol": "T_1",
          "meaning": "形状残差"
        },
        {
          "code": "t2",
          "symbol": "T_2",
          "meaning": "位置残差"
        }
      ],
      "sources": [
