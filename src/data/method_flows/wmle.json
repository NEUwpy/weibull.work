{
  "methodId": "wmle",
  "methodName": "加权极大似然估计 (WMLE)",
  "description": "通过引入三个权重 (J₁, J₂, J₃) 修正 MLE 在小样本下的偏差，偏差减少约 7 倍",
  "code": [
    "# WMLE 算法：加权极大似然估计",
    "# 输入: data - 原始失效时间样本",
    "# 输出: beta, eta, gamma - 威布尔分布参数",
    "",
    "import numpy as np",
    "from scipy.optimize import minimize",
    "",
    "# ========== 第1步：数据预处理 ==========",
    "# 获取排序后的数据、样本量和最小值",
    "arr = np.sort(data)",
    "n = len(arr)",
    "x_min = arr[0]",
    "",
    "# ========== 第2步：计算静态权重 J₁, J₂ ==========",
    "# 根据样本量 n 从权重表中查取",
    "J1 = get_weight_j1(n)  # 尺度参数权重",
    "J2 = get_weight_j2(n)  # 形状参数权重",
    "",
    "# ========== 第3步：初始化优化起点 ==========",
    "# 为 Nelder-Mead 优化设置初始猜测值",
    "gamma_init = 2.0  # 形状参数初始值（论文建议）",
    "alpha_init = 0.9 * x_min  # 位置参数初始值",
    "",
    "# ========== 第4步：定义 WMLE 目标函数 ==========",
    "# 目标函数 = term₁² + term₂²（论文公式4）",
    "def wmle_objective(params):",
    "    gamma, alpha = params",
    "    ",
    "    # 约束检查：gamma > 0, alpha < x_min",
    "    if gamma <= 0 or gamma > 10 or alpha >= x_min - 1e-6:",
    "        return 1e10",
    "    ",
    "    x_adj = arr - alpha",
    "    if np.any(x_adj <= 0):",
    "        return 1e10",
    "    ",
    "    log_x = np.log(x_adj)",
    "    x_gamma = x_adj ** gamma",
    "    ",
    "    sum_log = np.sum(log_x)",
    "    sum_log_x_gamma = np.sum(log_x * x_gamma)",
    "    sum_x_gamma = np.sum(x_gamma)",
    "    ",
    "    # 第一项：修正的形状参数似然方程",
    "    term1 = J2 / gamma + sum_log / n - sum_log_x_gamma / sum_x_gamma",
    "    ",
    "    # 第二项：修正的位置参数似然方程（动态权重 J₃）",
    "    J3 = get_weight_j3(n, gamma)",
    "    sum_inv = np.sum(1.0 / x_adj)",
    "    sum_x_gamma_minus1 = np.sum(x_adj ** (gamma - 1))",
    "    term2 = (sum_inv / n) * (sum_x_gamma / sum_x_gamma_minus1) - J3(gamma)",
    "    ",
    "    return term1 ** 2 + term2 ** 2",
    "",
    "# ========== 第5步：Nelder-Mead 优化 ==========",
    "# 同时优化形状参数 γ 和位置参数 α",
    "result = minimize(",
    "    wmle_objective,",
    "    x0=np.array([gamma_init, alpha_init]),",
    "    method='Nelder-Mead',",
    "    options={'maxiter': 500}",
    ")",
    "",
    "gamma_hat = result.x[0]  # 形状参数",
    "alpha_hat = result.x[1]  # 位置参数",
    "",
    "# ========== 第6步：代数计算尺度参数 η ==========",
    "# 使用最优的 γ* 和 α* 直接计算",
    "x_adj = arr - alpha_hat",
    "eta_hat = (np.sum(x_adj ** gamma_hat) / (n * J1)) ** (1 / gamma_hat)",
    "",
    "# ========== 第7步：计算拟合优度 R² ==========",
    "r2 = calculate_r2(gamma_hat, eta_hat, alpha_hat)",
    "",
    "# ========== 输出结果 ==========",
    "return [gamma_hat, eta_hat, alpha_hat, r2]"
  ],
