    {
      "name": "多根选择",
      "description": "在目标值距最低值≤10⁻¹²的候选中，按既有初值邻近规则选一个。",
      "basis": "工程选择：沿用原启发式β=2、γ=0.9tmin附近的距离规则。",
      "notes": "选择不使用仿真真值。",
      "formula": {
        "expression": "\\begin{gathered}\\mathcal C_*=\\{c:Q(c)\\le Q_{min}+10^{-12}\\}\\\\[5pt]\\hat c=\\arg\\min_{c\\in\\mathcal C_*}\\left[\\ln^2(\\beta/2)+\\left(\\frac{\\gamma-0.9u}{\\max(u,1)}\\right)^2\\right]\\end{gathered}",
