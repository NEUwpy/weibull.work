    {
      "name": "两个加权方程",
      "description": "用中心化对数距离和归一化幂权重计算T₁、T₂，目标是两者同时为零。",
      "basis": "方法核心：原J₂/J₃加权方程；用logsumexp稳定幂和。",
      "notes": "",
      "formula": {
        "expression": "\\begin{gathered}d_i=t_i-\\gamma\\\\[5pt] v_i=\\ln d_i-\\overline{\\ln d}\\\\[5pt] w_i=\\frac{e^{\\beta v_i}}{\\sum_j e^{\\beta v_j}}\\\\[5pt] T_1=\\frac{J_2}{\\beta}-\\sum_iw_iv_i\\\\[5pt] T_2=\\overline{d^{-1}}\\frac{\\sum_i d_i^\\beta}{\\sum_i d_i^{\\beta-1}}-J_3\\end{gathered}",
        "explanation": "用中心化对数距离和归一化幂权重计算T₁、T₂，目标是两者同时为零。",
        "symbols": [
          {
            "symbol": "T_1",
            "meaning": "形状残差"
          },
          {
            "symbol": "T_2",
            "meaning": "位置残差"
          },
          {
            "symbol": "d_i",
            "meaning": "平移距离"
          },
          {
            "symbol": "v_i",
            "meaning": "中心化对数距离"
          },
          {
            "symbol": "w_i",
            "meaning": "归一化幂权重"
          }
        ]
      },
