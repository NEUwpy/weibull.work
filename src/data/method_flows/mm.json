{
  "schemaVersion": 2,
  "methodId": "mm",
  "methodName": "矩估计 (MM)",
  "description": "Cran Weibull矩 → 显式三参数解 → 位置可采纳性修正。",
  "steps": [
    {
      "id": 1,
      "name": "数据预处理",
      "description": "获取排序后的失效时间数据和样本数量",
      "formula": {
        "expression": "x_{(1)} \\leq x_{(2)} \\leq \\cdots \\leq x_{(n)}",
        "symbols": [
          {
            "symbol": "x",
            "meaning": "排序后的失效时间数组"
          },
          {
            "symbol": "n",
            "meaning": "样本数量"
          }
        ],
        "explanation": "获取排序后的失效时间数据和样本数量"
      },
      "inputs": [
        {
          "code": "data",
          "symbol": "x_i",
          "meaning": "原始失效时间样本"
        }
      ],
      "outputs": [
        {
          "code": "x",
          "symbol": "x",
          "meaning": "排序后数组"
        },
        {
          "code": "n",
          "symbol": "n",
          "meaning": "样本数量"
        }
      ],
      "basis": "公共输入规则：有限、严格为正的失效时间，统一排序。",
      "notes": "当前实现处理完整失效样本；不包含删失样本似然。本方法在 run 内要求 n≥3。",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 1 | 数据预处理 | 获取排序后的失效时间数据和样本数量",
          "until": "# @step: 2 | 计算样本 Weibull 矩 | 用生存函数阶梯估计计算 k=1,2,4 阶样本矩（论文式(3)）"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase.__init__",
          "label": "输入校验与排序"
        }
      ]
    },
    {
      "id": 2,
      "name": "计算样本 Weibull 矩",
      "description": "用生存函数阶梯估计计算 k=1,2,4 阶样本矩（论文式(3)）",
      "formula": {
        "expression": "\\bar{m}_k = \\sum_{r=0}^{n-1}\\left(1-\\frac{r}{n}\\right)^k (x_{(r+1)} - x_{(r)}), \\quad x_{(0)}=0",
        "symbols": [
          {
            "symbol": "\\bar{m}_k",
            "meaning": "k 阶样本 Weibull 矩"
          }
        ],
        "explanation": "用生存函数阶梯估计计算 k=1,2,4 阶样本矩（论文式(3)）"
      },
      "inputs": [
        {
          "code": "x",
          "symbol": "x",
          "meaning": "排序后数组"
        },
        {
          "code": "n",
          "symbol": "n",
          "meaning": "样本数量"
        }
      ],
      "outputs": [
        {
          "code": "m1",
          "symbol": "\\bar{m}_1",
          "meaning": "一阶矩（等于样本均值）"
        },
        {
          "code": "m2",
          "symbol": "\\bar{m}_2",
          "meaning": "二阶矩"
        },
        {
          "code": "m4",
          "symbol": "\\bar{m}_4",
          "meaning": "四阶矩"
        }
      ],
      "basis": "Cran (1988) Weibull矩构造；m₂、m₄不是样本普通二阶和四阶幂矩。",
      "notes": "m₁等于均值；m₂、m₄由阶梯生存函数加权间距得到。",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "sample_weibull_moment",
          "label": "Weibull矩求和"
        },
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 2 | 计算样本 Weibull 矩 | 用生存函数阶梯估计计算 k=1,2,4 阶样本矩（论文式(3)）",
          "until": "# @step: 3 | 采纳性检查 | 论文：当 m̄2 >= (m̄1+m̄4)/2 时 c*, b* 非正，矩估计不可用"
        }
      ]
    },
    {
      "id": 3,
      "name": "采纳性检查",
      "description": "论文：当 m̄2 >= (m̄1+m̄4)/2 时 c*, b* 非正，矩估计不可用",
      "formula": {
        "expression": "\\bar{m}_1 - \\bar{m}_2 > \\bar{m}_2 - \\bar{m}_4 > 0",
        "symbols": [
          {
            "symbol": "\\bar{m}_k",
            "meaning": "样本 Weibull 矩"
          }
        ],
        "explanation": "论文：当 m̄2 >= (m̄1+m̄4)/2 时 c*, b* 非正，矩估计不可用"
      },
      "inputs": [
        {
          "code": "m1",
          "symbol": "\\bar{m}_1",
          "meaning": "一阶矩"
        },
        {
          "code": "m2",
          "symbol": "\\bar{m}_2",
          "meaning": "二阶矩"
        },
        {
          "code": "m4",
          "symbol": "\\bar{m}_4",
          "meaning": "四阶矩"
        }
      ],
      "outputs": [
        {
          "code": "solved",
          "symbol": "(\\beta,\\gamma,\\eta)",
          "meaning": "可采纳显式解或None"
        }
      ],
      "basis": "矩组合的可采纳条件：要求d₁₂>d₂₄>0，否则返回inadmissible_moments。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "solve_from_weibull_moments",
          "label": "矩方程与可采纳条件",
          "from": "d12 = m1 - m2",
          "through": "return None"
        },
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 3 | 采纳性检查 | 论文：当 m̄2 >= (m̄1+m̄4)/2 时 c*, b* 非正，矩估计不可用",
          "until": "# @step: 4 | 显式解参数 | 论文式(2a)-(2c)：由低阶矩显式解形状、位置、尺度"
        }
      ]
    },
    {
      "id": 4,
      "name": "显式解参数",
      "description": "论文式(2a)-(2c)：由低阶矩显式解形状、位置、尺度",
      "formula": {
        "expression": "\\begin{gathered}\\beta^*=\\frac{\\ln2}{\\ln(m_1-m_2)-\\ln(m_2-m_4)}\\\\[5pt] \\gamma^*=\\frac{m_1m_4-m_2^2}{m_1+m_4-2m_2}\\\\[5pt] \\eta^*=\\frac{m_1-\\gamma^*}{\\Gamma(1+1/\\beta^*)}\\end{gathered}",
        "explanation": "辅助函数返回顺序为(shape,location,scale)；run最终返回顺序为(shape,scale,location,R²,status)。",
        "symbols": [
          {
            "symbol": "\\beta^*,\\gamma^*,\\eta^*",
            "meaning": "未修正的三参数解"
          }
        ]
      },
      "inputs": [
        {
          "code": "m1",
          "symbol": "\\bar{m}_1",
          "meaning": "一阶矩"
        },
        {
          "code": "m2",
          "symbol": "\\bar{m}_2",
          "meaning": "二阶矩"
        },
        {
          "code": "m4",
          "symbol": "\\bar{m}_4",
          "meaning": "四阶矩"
        }
      ],
      "outputs": [
        {
          "code": "shape",
          "symbol": "\\beta^*",
          "meaning": "形状"
        },
        {
          "code": "location",
          "symbol": "\\gamma^*",
          "meaning": "位置"
        },
        {
          "code": "scale",
          "symbol": "\\eta^*",
          "meaning": "尺度"
        }
      ],
      "basis": "Cran显式解：原文c、a、b分别对应全站β、γ、η。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "solve_from_weibull_moments",
          "label": "显式解公式",
          "from": "shape = math.log(2.0)",
          "through": "return shape, location, scale"
        },
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 4 | 显式解参数 | 论文式(2a)-(2c)：由低阶矩显式解形状、位置、尺度",
          "until": "# @step: 5 | 位置参数可采纳性修正 | a*<0 置零；a*>=x_(1) 用论文替代式 a**"
        }
      ]
    },
    {
      "id": 5,
      "name": "位置参数可采纳性修正",
      "description": "a*<0 置零；a*>=x_(1) 用论文替代式 a**",
      "formula": {
        "expression": "\\begin{gathered}\\gamma^*<0\\Rightarrow\\hat\\gamma=0;\\\\[5pt]\\gamma^*\\ge t_{(1)}\\Rightarrow\\hat\\gamma=\\max\\left(0,t_{(1)}-\\frac{\\eta^*\\Gamma(1+1/\\beta^*)}{n^{1/\\beta^*}}\\right)\\\\[5pt]\\hat\\eta=\\frac{m_1-\\hat\\gamma}{\\Gamma(1+1/\\beta^*)}\\end{gathered}",
        "explanation": "每次位置修正后重算尺度；修正仍不满足支撑或尺度为非正时失败。",
        "symbols": [
          {
            "symbol": "\\hat\\gamma",
            "meaning": "修正后位置"
          },
          {
            "symbol": "\\hat\\eta",
            "meaning": "重算的尺度"
          }
        ]
      },
      "inputs": [
        {
          "code": "location",
          "symbol": "\\gamma^*",
          "meaning": "位置参数"
        },
        {
          "code": "shape",
          "symbol": "\\beta^*",
          "meaning": "形状参数"
        },
        {
          "code": "scale",
          "symbol": "\\eta^*",
          "meaning": "尺度参数"
        }
      ],
      "outputs": [
        {
          "code": "location",
          "symbol": "\\hat\\gamma",
          "meaning": "修正后的位置参数"
        },
        {
          "code": "scale",
          "symbol": "\\hat\\eta",
          "meaning": "修正后的尺度参数"
        }
      ],
      "basis": "可采纳性处理：负位置置零；位置越过最小样本时采用论文替代位置并重算尺度。",
      "notes": "",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 5 | 位置参数可采纳性修正 | a*<0 置零；a*>=x_(1) 用论文替代式 a**",
          "until": "# @step: 6 | 2P 对照估计 | 论文 LOCATION 节：同时计算 a=0 的两参数矩估计用于阈值判断"
        }
      ]
    },
    {
      "id": 6,
      "name": "2P 对照估计",
      "description": "论文 LOCATION 节：同时计算 a=0 的两参数矩估计用于阈值判断",
      "formula": {
        "expression": "c^{**} = \\frac{\\ln 2}{\\ln \\bar{m}_1 - \\ln \\bar{m}_2}, \\quad b^{**} = \\bar{m}_1 / \\Gamma(1+1/c^{**})",
        "symbols": [
          {
            "symbol": "c^{**}",
            "meaning": "2P 形状估计"
          },
          {
            "symbol": "b^{**}",
            "meaning": "2P 尺度估计"
          }
        ],
        "explanation": "论文 LOCATION 节：同时计算 a=0 的两参数矩估计用于阈值判断"
      },
      "inputs": [
        {
          "code": "m1",
          "symbol": "\\bar{m}_1",
          "meaning": "一阶矩"
        },
        {
          "code": "m2",
          "symbol": "\\bar{m}_2",
          "meaning": "二阶矩"
        }
      ],
      "outputs": [
        {
          "code": "two_param_shape",
          "symbol": "c^{**}",
          "meaning": "2P 形状"
        },
        {
          "code": "two_param_scale",
          "symbol": "b^{**}",
          "meaning": "2P 尺度"
        }
      ],
      "basis": "诊断对照：计算零位置的两参数矩估计，记录在last_solution_info。",
      "notes": "两参数结果不替换本次三参数返回值，也不参与当前代码的最终选择。",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 6 | 2P 对照估计 | 论文 LOCATION 节：同时计算 a=0 的两参数矩估计用于阈值判断",
          "until": "# @step: 7 | 计算拟合优度 R² | 评估模型与数据的拟合程度"
        }
      ]
    },
    {
      "id": 7,
      "name": "计算拟合优度 R²",
      "description": "评估模型与数据的拟合程度",
      "formula": {
        "expression": "y_i=\\ln[-\\ln(1-p_i)],\\quad \\hat y_i=\\beta\\ln(t_i-\\gamma)-\\beta\\ln\\eta,\\quad R^2=1-\\frac{\\sum_i(y_i-\\hat y_i)^2}{\\sum_i(y_i-\\bar y)^2}",
        "explanation": "R²在双对数概率图空间计算，pᵢ来自当前 rank_method；不是原始CDF空间的残差。",
        "symbols": [
          {
            "symbol": "R^2",
            "meaning": "概率图决定系数"
          },
          {
            "symbol": "p_i",
            "meaning": "绘图位置"
          },
          {
            "symbol": "y_i",
            "meaning": "变换后的经验值"
          },
          {
            "symbol": "\\hat y_i",
            "meaning": "参数预测值"
          }
        ]
      },
      "inputs": [
        {
          "code": "shape",
          "symbol": "\\hat\\beta",
          "meaning": "形状参数"
        },
        {
          "code": "scale",
          "symbol": "\\hat\\eta",
          "meaning": "尺度参数"
        },
        {
          "code": "location",
          "symbol": "\\hat\\gamma",
          "meaning": "位置参数"
        }
      ],
      "outputs": [
        {
          "code": "r2",
          "symbol": "R^2",
          "meaning": "拟合优度"
        }
      ],
      "basis": "项目诊断：共用基础类的概率图 R²，不参与核心参数求解。",
      "notes": "γ触及样本最小值或总平方和为零时返回0；普通情况下允许负R²。",
      "sources": [
        {
          "file": "python/methods/mm.py",
          "symbol": "MM.run",
          "label": "本步实现",
          "from": "# @step: 7 | 计算拟合优度 R² | 评估模型与数据的拟合程度"
        },
        {
          "file": "python/base.py",
          "symbol": "WeibullBase._calculate_r2",
          "label": "概率图 R²"
        },
        {
