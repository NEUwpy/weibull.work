    {
      "id": 13,
      "name": "计算拟合优度 R²",
      "description": "评估模型与数据的拟合程度，R² 越接近1表示拟合越好",
      "formula": "R^2 = 1 - \\frac{\\sum(F_i - \\hat{F}_i)^2}{\\sum(F_i - \\bar{F})^2}",
