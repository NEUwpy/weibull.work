            "meaning": "平移后的正距离"
          },
          {
            "symbol": "v_i",
            "meaning": "中心化对数距离"
          },
          {
            "symbol": "w_i",
            "meaning": "归一化幂权重"
          },
          {
            "symbol": "s_β",
            "meaning": "形状得分"
          }
        ]
