{
  "methodId": "mle",
  "methodName": "极大似然估计 (MLE)",
  "description": "通过最大化对数似然函数来估计威布尔分布参数，展示从输入样本到输出参数的完整计算过程",
  "code": [
    "# MLE 算法：极大似然估计",
    "# 输入: data - 原始失效时间样本",
    "# 输出: beta, eta, gamma - 威布尔分布参数",
    "",
    "import numpy as np",
    "from scipy.optimize import minimize",
    "",
    "# ========== 第1步：数据预处理 ==========",
    "# 去除无效值，排序数据",
    "arr = np.array(sorted([x for x in data if x > 0]))",
    "n = len(arr)",
    "",
    "# ========== 第2步：计算中位秩 ==========",
    "# 使用 Bernard 公式计算经验累积概率",
    "F = (np.arange(1, n + 1) - 0.3) / (n + 0.4)",
    "",
    "# ========== 第3步：线性变换 ==========",
    "# 对数据进行对数线性化变换",
    "y = np.log(-np.log(1 - F))",
    "x = np.log(arr)",
    "",
    "# ========== 第4步：线性回归求初值 ==========",
    "# 通过对数坐标系的线性回归获得参数初始估计",
    "slope, intercept = np.polyfit(x, y, 1)",
    "beta_init = max(0.5, slope)",
    "eta_init = np.exp(-intercept / slope)",
    "gamma_init = 0.0",
    "",
    "# ========== 第5步：定义对数似然函数 ==========",
    "def neg_log_likelihood(params):",
    "    beta, eta, gamma = params",
    "    ",
    "    # 约束检查",
    "    if beta <= 0.01 or eta <= 0.01 or gamma < 0:",
    "        return 1e10",
    "    if gamma >= arr[0]:",
    "        return 1e10",
    "    ",
    "    # 计算标准化变量",
    "    z = (arr - gamma) / eta",
    "    ",
    "    # 检查 z 是否都大于0",
    "    if np.any(z <= 0):",
    "        return 1e10",
    "    ",
    "    # 计算对数似然（负值用于最小化）",
    "    ll = (n * np.log(beta) - n * np.log(eta) +",
    "          (beta - 1) * np.sum(np.log(z)) -",
    "          np.sum(z ** beta))",
    "    ",
    "    return -ll",
    "",
    "# ========== 第6步：数值优化 ==========",
    "# 使用 Nelder-Mead 无导数优化算法",
    "result = minimize(",
    "    neg_log_likelihood,",
    "    [beta_init, eta_init, gamma_init],",
    "    method='Nelder-Mead',",
    "    options={'maxiter': 1000, 'xatol': 1e-8, 'fatol': 1e-8}",
    ")",
    "",
    "# ========== 第7步：检查无界问题 ==========",
    "# Smith (1985): 当 β < 1 时，似然函数无界",
    "beta_hat, eta_hat, gamma_hat = result.x",
    "if beta_hat < 1.0:",
    "    return [beta_hat, eta_hat, gamma_hat, 0, 'unbounded']",
    "",
    "# ========== 第8步：计算拟合优度 ==========",
    "# 评估模型与数据的拟合程度",
    "F_pred = 1 - np.exp(-((arr - gamma_hat) / eta_hat) ** beta_hat)",
    "ss_res = np.sum((F - F_pred) ** 2)",
    "ss_tot = np.sum((F - np.mean(F)) ** 2)",
    "r2 = 1 - ss_res / ss_tot",
    "",
    "# ========== 输出结果 ==========",
    "return [beta_hat, eta_hat, gamma_hat, r2, 'success']"
  ],
  "steps": [
    {
      "id": 1,
      "name": "数据预处理",
      "description": "对原始样本进行排序，去除无效值，获取样本数量",
      "formula": "t_{(1)} \\leq t_{(2)} \\leq \\cdots \\leq t_{(n)}",
      "inputs": {
        "data": "原始失效时间样本"
      },
      "outputs": {
        "arr": "排序后的失效时间数组",
        "n": "样本数量"
      },
      "codeLines": [12, 13],
      "variables": [
        { "name": "arr", "value": "[25.3, 47.8, 73.2, 89.5, 112.4]", "type": "intermediate" },
        { "name": "n", "value": 5, "type": "intermediate", "highlighted": true }
      ],
      "note": "确保所有失效时间大于0，按升序排列"
    },
    {
      "id": 2,
      "name": "计算中位秩",
      "description": "使用 Bernard 公式计算经验累积概率，为线性回归初值准备数据",
      "formula": "F(t_i) = \\frac{i - 0.3}{n + 0.4}",
      "detailFormula": " Bernard's 中位秩公式，无偏估计",
      "inputs": {
        "i": "样本序号 (1, 2, ..., n)",
        "n": "样本数量"
      },
      "outputs": {
        "F": "中位秩数组 (经验累积概率)"
      },
      "codeLines": [17],
      "variables": [
        { "name": "F", "value": "[0.130, 0.313, 0.500, 0.688, 0.875]", "type": "intermediate", "highlighted": true }
      ],
      "note": "中位秩表示第i个失效时间对应的累积失效概率的估计值"
    },
    {
      "id": 3,
      "name": "线性变换",
      "description": "对数据进行对数线性化变换，将威布尔分布转换为线性形式",
      "formula": "Y = \\ln(-\\ln(1-F)), \\quad X = \\ln(t)",
      "detailFormula": "由 F(t) = 1 - \\exp(-(t/\\eta)^\\beta) 推导可得",
      "inputs": {
        "F": "中位秩数组",
        "arr": "失效时间数组"
      },
      "outputs": {
        "x": "对数化的失效时间",
        "y": "变换后的响应变量"
      },
      "codeLines": [21, 22],
      "variables": [
        { "name": "x", "value": "[3.231, 3.867, 4.293, 4.495, 4.723]", "type": "intermediate" },
        { "name": "y", "value": "[0.139, 0.377, 0.693, 1.158, 2.079]", "type": "intermediate", "highlighted": true }
      ],
      "note": "线性化后，Y与X呈线性关系：Y = β·X - β·ln(η)"
    },
    {
      "id": 4,
      "name": "线性回归求初值",
      "description": "通过对数变换后的线性回归获得参数的初始估计，为数值优化提供起点",
      "formula": "\\beta_0 = \\text{slope}, \\quad \\eta_0 = e^{-\\text{intercept}/\\text{slope}}",
      "inputs": {
        "x": "对数化的失效时间",
        "y": "变换后的响应变量"
      },
      "outputs": {
        "β₀": "初始形状参数（斜率）",
        "η₀": "初始尺度参数",
        "γ₀": "初始位置参数（设为0）"
      },
      "codeLines": [26, 27, 28, 29],
      "variables": [
        { "name": "slope", "value": 0.8234, "type": "intermediate" },
        { "name": "intercept", "value": -2.4856, "type": "intermediate" },
        { "name": "beta_init", "value": 0.8234, "type": "intermediate" },
        { "name": "eta_init", "value": 95.28, "type": "intermediate" },
        { "name": "gamma_init", "value": 0.0, "type": "intermediate", "highlighted": true }
      ],
      "note": "线性回归初值能显著提高数值优化的收敛速度和稳定性"
    },
    {
      "id": 5,
      "name": "定义对数似然函数",
      "description": "构造三参数威布尔分布的对数似然函数（取负值用于最小化）",
      "formula": "\\ell(\\beta,\\eta,\\gamma) = n\\ln\\beta - n\\ln\\eta + (\\beta-1)\\sum\\ln z_i - \\sum z_i^{\\beta}",
      "detailFormula": "其中 z_i = \\frac{t_i - \\gamma}{\\eta}, \\quad t_i > \\gamma",
      "inputs": {
        "params": "参数向量 [β, η, γ]",
        "arr": "排序后的失效时间",
        "n": "样本数量"
      },
      "outputs": {
        "负对数似然": "目标函数值（越小=似然越大）"
      },
      "codeLines": [33, 35, 36, 37, 40, 42, 45, 46, 47, 48],
      "variables": [
        { "name": "params", "value": "[β, η, γ]", "type": "input" },
        { "name": "β", "value": "> 0.01", "type": "input" },
        { "name": "η", "value": "> 0.01", "type": "input" },
        { "name": "γ", "value": "≥ 0", "type": "input" }
      ],
      "note": "优化算法最小化负对数似然等价于最大化对数似然"
    },
    {
      "id": 6,
      "name": "定义约束条件",
      "description": "设置参数的物理约束，确保估计值有意义",
      "formula": "\\beta > 0.01, \\quad \\eta > 0.01, \\quad \\gamma \\geq 0, \\quad \\gamma < t_{(1)}",
      "inputs": {
        "β": "形状参数候选值",
        "η": "尺度参数候选值",
        "γ": "位置参数候选值",
        "arr[0]": "最小失效时间"
      },
      "outputs": {
        "约束检查结果": "违反约束时返回1e10惩罚值"
      },
      "codeLines": [35, 36, 37, 40, 42],
      "variables": [
        { "name": "约束β>0.01", "value": "✓", "type": "intermediate" },
        { "name": "约束η>0.01", "value": "✓", "type": "intermediate" },
        { "name": "约束γ≥0", "value": "✓", "type": "intermediate" },
        { "name": "约束γ<t₍₁₎", "value": "✓", "type": "intermediate", "highlighted": true }
      ],
      "note": "物理约束确保参数在合理范围内，位置参数必须小于最小失效时间"
    },
    {
      "id": 7,
      "name": "计算标准化变量",
      "description": "计算标准化后的数据 z，用于似然函数计算",
      "formula": "z_i = \\frac{t_i - \\gamma}{\\eta}",
      "inputs": {
        "arr": "失效时间数组",
        "γ": "位置参数",
        "η": "尺度参数"
      },
      "outputs": {
        "z": "标准化变量数组"
      },
      "codeLines": [40, 45],
      "variables": [
        { "name": "z", "value": "[0.266, 0.502, 0.769, 0.941, 1.182]", "type": "intermediate", "highlighted": true }
      ],
      "note": "z值必须都大于0，否则对数似然无定义"
    },
    {
      "id": 8,
      "name": "计算对数似然值",
      "description": "根据当前参数计算对数似然函数值",
      "formula": "\\ell = n\\ln\\beta - n\\ln\\eta + (\\beta-1)\\sum\\ln z_i - \\sum z_i^{\\beta}",
      "inputs": {
        "n": "样本数量",
        "β, η, γ": "当前参数值",
        "z": "标准化变量"
      },
      "outputs": {
        "负对数似然": "目标函数值"
      },
      "codeLines": [46, 47, 48],
      "variables": [
        { "name": "n·ln(β)", "value": "-0.971", "type": "intermediate" },
        { "name": "-n·ln(η)", "value": "-22.78", "type": "intermediate" },
        { "name": "(β-1)Σln(z)", "value": "0.181", "type": "intermediate" },
        { "name": "-Σz^β", "value": "4.286", "type": "intermediate" },
        { "name": "neg_log_lik", "value": 8.724, "type": "intermediate", "highlighted": true }
      ],
      "note": "优化算法的目标是找到使这个值最小的参数组合"
    },
    {
      "id": 9,
      "name": "数值优化",
      "description": "使用 Nelder-Mead 无导数优化算法搜索使对数似然最大的参数组合",
      "formula": "\\{\\hat{\\beta}, \\hat{\\eta}, \\hat{\\gamma}\\} = \\arg\\max_{\\beta, \\eta, \\gamma} \\ell(\\beta, \\eta, \\gamma)",
      "inputs": {
        "初始值": "[beta_init, eta_init, gamma_init]",
        "目标函数": "neg_log_likelihood",
        "算法": "Nelder-Mead"
      },
      "outputs": {
        "优化结果": "包含最优参数和收敛信息"
      },
      "codeLines": [52, 53, 54, 55, 56],
      "variables": [
        { "name": "method", "value": "Nelder-Mead", "type": "input" },
        { "name": "maxiter", "value": 1000, "type": "input" },
        { "name": "xatol", "value": "1e-8", "type": "input" },
        { "name": "fatol", "value": "1e-8", "type": "input" },
        { "name": "初始值", "value": "[0.823, 95.28, 0.0]", "type": "input", "highlighted": true }
      ],
      "note": "Nelder-Mead是一种无导数优化算法，适用于不可导或导数难计算的情况",
      "isLoop": true,
      "loopCount": "~15次迭代"
    },
    {
      "id": 10,
      "name": "优化迭代过程",
      "description": "优化算法逐步调整参数，使似然函数值最大化，直到满足收敛条件",
      "formula": "\\text{迭代: } \\{\\beta^{(k+1)}, \\eta^{(k+1)}, \\gamma^{(k+1)}\\} = \\text{Nelder-Mead}(\\{\\beta^{(k)}, \\eta^{(k)}, \\gamma^{(k)}\\})",
      "inputs": {
        "当前参数": "β⁽ᵏ⁾, η⁽ᵏ⁾, γ⁽ᵏ⁾",
        "目标函数": "neg_log_likelihood"
      },
      "outputs": {
        "更新参数": "β⁽ᵏ⁺¹⁾, η⁽ᵏ⁺¹⁾, γ⁽ᵏ⁺¹⁾"
      },
      "codeLines": [52, 53, 54, 55, 56],
      "variables": [
        { "name": "iter", "value": 1, "type": "intermediate" },
        { "name": "β", "value": 0.8234, "type": "intermediate" },
        { "name": "η", "value": 95.28, "type": "intermediate" },
