    {
      "id": 12,
      "name": "检查 Smith 无界问题",
      "description": "当 β < 1 时，似然函数在参数空间内无界，不存在 MLE 解（Smith, 1985）",
      "formula": "\\text{If } \\hat{\\beta} < 1, \\text{ 无 MLE 解存在}",
      "inputs": {
        "β*": "优化得到的形状参数"
      },
      "outputs": {
